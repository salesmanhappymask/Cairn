        dz = 0,
        world = "Down"
    }
}

local slaveMoves = {
    forward = moves.forward,
    right = moves.right,
    down = moves.down
}


local function migrateLegacyState()
    local id = os.getComputerID()

    if id == MASTER_ID then
        if fs.exists(LEGACY_MAIN_STATE_FILE) then
            if not fs.exists(MAIN_STATE_FILE) then
                fs.move(LEGACY_MAIN_STATE_FILE, MAIN_STATE_FILE)
            else
                fs.delete(LEGACY_MAIN_STATE_FILE)
            end
        end
    elseif id == SLAVE_ID then
        if fs.exists(LEGACY_SLAVE_STATE_FILE) then
            if not fs.exists(SLAVE_STATE_FILE) then
                fs.move(LEGACY_SLAVE_STATE_FILE, SLAVE_STATE_FILE)
            else
                fs.delete(LEGACY_SLAVE_STATE_FILE)
            end
        end
    end
end

local function readTable(path)
    if not fs.exists(path) then
        return nil
    end

    local h = fs.open(path, "r")

    if not h then
        return nil
    end

    local raw = h.readAll()
    h.close()

    return textutils.unserialize(raw)
end

local function writeTable(path, value)
    local h = fs.open(path, "w")

    if not h then
        return false
    end

    h.write(textutils.serialize(value))
    h.close()

    return true
end

local function clearMainOutputs()
    redstone.setOutput("front", false)
    redstone.setOutput("back", false)
    redstone.setOutput("right", false)
    redstone.setOutput("bottom", false)
end

local function clearSlaveOutputs()
    redstone.setOutput("front", false)
    redstone.setOutput("back", false)
    redstone.setOutput("left", false)
    redstone.setOutput("right", false)
    redstone.setOutput("top", false)
end

local function modemWireless(side)
    if peripheral.getType(side) ~= "modem" then
        return nil
    end

    local ok, value = pcall(peripheral.call, side, "isWireless")

    if not ok then
        return nil
    end

    return value
end

local function openModem(side)
    if peripheral.getType(side) ~= "modem" then
        return false
    end

    if not rednet.isOpen(side) then
        rednet.open(side)
    end

    return true
end

local function checkMainHardware()
    if peripheral.getType(MASTER_WIRED_SIDE) ~= "modem" then
        return false, "Drive2 requires its wired modem on left."
    end

    if modemWireless(MASTER_WIRED_SIDE) ~= false then
        return false, "Drive2 left modem must be wired."
    end

    if peripheral.getType(MASTER_WIRELESS_SIDE) ~= "modem" then
        return false, "Drive2 requires its wireless modem on top."
    end

    if modemWireless(MASTER_WIRELESS_SIDE) ~= true then
        return false, "Drive2 top modem must be wireless."
    end

    return true
end

local function checkSlaveHardware()
    if peripheral.getType(SLAVE_WIRED_SIDE) ~= "modem" then
        return false, "Drive1 requires its wired modem on bottom."
    end

    if modemWireless(SLAVE_WIRED_SIDE) ~= false then
        return false, "Drive1 bottom modem must be wired."
    end

    return true
end

local function findSlaveWireless()
    local sides = {
        "top",
        "front",
        "back",
        "left",
        "right"
    }

    for _, side in ipairs(sides) do
        if peripheral.getType(side) == "modem" then
            local ok, wireless = pcall(
                peripheral.call,
                side,
                "isWireless"
            )

            if ok and wireless == true then
                return side
            end
        end
    end

    return nil
end

local function saveMainState(state)
    return writeTable(MAIN_STATE_FILE, state)
end

local function loadMainState()
    local state = readTable(MAIN_STATE_FILE)

    if type(state) ~= "table" then
        return nil
    end

    if
        state.version == 3 or
        state.version == 4 or
        state.version == 5
    then
        state.version = MAIN_STATE_VERSION
        state.paused = state.paused == true
        state.routeMode = state.routeMode or "roundtrip"
        state.lastControlToken = nil
        state.lastControlReply = nil

        if state.stage == "complete" then
            state.stage = "idle"
            state.routeMode = "idle"
        end

        saveMainState(state)
        return state
    end

    if state.version ~= MAIN_STATE_VERSION then
        fs.delete(MAIN_STATE_FILE)
        return nil
    end

    state.paused = state.paused == true
    state.routeMode = state.routeMode or "idle"

    return state
end

local function loadSlaveState()
    local state = readTable(SLAVE_STATE_FILE)

    if type(state) ~= "table" then
        return {
            version = SLAVE_STATE_VERSION,
            boot = 0,
            tx = nil
        }
    end

    if state.version == 2 or state.version == 3 then
        state.version = SLAVE_STATE_VERSION
        writeTable(SLAVE_STATE_FILE, state)
        return state
    end

    if state.version ~= SLAVE_STATE_VERSION then
        return {
            version = SLAVE_STATE_VERSION,
            boot = 0,
            tx = nil
        }
    end

    return state
end

local function saveSlaveState(state)
    return writeTable(SLAVE_STATE_FILE, state)
end

local function askInteger(label)
    while true do
        write(label .. ": ")
        local raw = read()
        local value = tonumber(raw)

        if value and value == math.floor(value) then
            return value
        end

        print("Please enter a whole-number coordinate.")
    end
end

