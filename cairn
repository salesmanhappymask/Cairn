        end
    end
end

local function queueControl(message)
    if type(message) ~= "table" then
        return
    end

    controlQueue[#controlQueue + 1] = message
end

local function waitLinkType(expected, token, timeout)
    local deadline = os.clock() + timeout

    while os.clock() < deadline do
        local remaining = deadline - os.clock()
        local sender, message = rednet.receive(LINK_PROTOCOL, remaining)

        if not sender then
            return nil
        end

        if sender == SLAVE_ID and type(message) == "table" then
            if
                message.type == "control_relay" and
                type(message.message) == "table"
            then
                queueControl(message.message)

            elseif message.type == expected then
                if token == nil or message.token == token then
                    return message
                end
            end
        end
    end

    return nil
end

local function pingSlaveOnce()
    local token =
        "ping:" ..
        tostring(os.getComputerID()) ..
        ":" ..
        tostring(math.floor(os.clock() * 1000))

    rednet.send(SLAVE_ID, {
        type = "ping",
        token = token
    }, LINK_PROTOCOL)

    return waitLinkType("pong", token, LINK_TIMEOUT)
end

local function pingSlave()
    for attempt = 1, LINK_ATTEMPTS do
        local reply = pingSlaveOnce()

        if reply then
            return reply
        end

        sleep(0.05)
    end

    return nil
end

local function prepareSlave(tx)
    for attempt = 1, LINK_ATTEMPTS do
        rednet.send(SLAVE_ID, {
            type = "prepare",
            token = tx.token,
            direction = tx.direction,
            executor = tx.owner
        }, LINK_PROTOCOL)

        local reply = waitLinkType("prepared", tx.token, LINK_TIMEOUT)

        if reply then
            return true
        end

        sleep(0.05)
    end

    return false
end

local function querySlaveTx(token)
    rednet.send(SLAVE_ID, {
        type = "tx_status",
        token = token
    }, LINK_PROTOCOL)

    return waitLinkType("tx_status", token, LINK_TIMEOUT)
end

local function commitSlave(token)
    rednet.send(SLAVE_ID, {
        type = "commit",
        token = token
    }, LINK_PROTOCOL)

    waitLinkType("commit_ack", token, 0.75)
end

local function pulseMain(side)
    clearMainOutputs()
    redstone.setOutput(side, true)
    sleep(PULSE_TIME)
    redstone.setOutput(side, false)
    sleep(MOVE_SETTLE_TIME)
end

local function commitMove(state)
    local tx = state.tx

    if not tx then
        return false
    end

    local move = moves[tx.direction]

    if not move then
        return false
    end

    state.current.x = state.current.x + move.dx
    state.current.y = state.current.y + move.dy
    state.current.z = state.current.z + move.dz

    local token = tx.token

    state.tx = nil

    saveMainState(state)
    commitSlave(token)

    drawRoute(state)

    return true
end

local function recoveryFailure(state, message)
    local tx = state.tx

    if not tx then
        return
    end

    tx.recoveryReboots = (tx.recoveryReboots or 0) + 1
    saveMainState(state)

    term.clear()
    term.setCursorPos(1, 1)
    print("CAIRN MOVEMENT RECOVERY")
    print("")
    print(message)
    print("")
    print(
        "Automatic recovery reboot " ..
        tx.recoveryReboots ..
        "/" ..
        MAX_RECOVERY_REBOOTS
    )

    if tx.recoveryReboots <= MAX_RECOVERY_REBOOTS then
        sleep(1.5)
        os.reboot()
        return
    end

    print("")
    print("Automatic recovery limit reached.")
    print("Press Enter to retry recovery.")
    print("Type CANCEL to discard the trip.")

    local answer = string.lower(read() or "")

    if answer == "cancel" then
        if fs.exists(MAIN_STATE_FILE) then
            fs.delete(MAIN_STATE_FILE)
        end
        os.reboot()
        return
    end

    tx.recoveryReboots = 0
    saveMainState(state)
    os.reboot()
end

local function confirmLocalMove(state)
    local tx = state.tx

    for attempt = 1, LINK_ATTEMPTS do
        local reply = querySlaveTx(tx.token)

        if reply and reply.present == true then
            return commitMove(state)
        end

        sleep(0.1)
    end

    recoveryFailure(
        state,
        "Drive1 slave did not check in after Drive2 movement."
    )

    return false
end

local function sendSlaveExecute(tx)
    rednet.send(SLAVE_ID, {
        type = "execute",
        token = tx.token,
        direction = tx.direction
    }, LINK_PROTOCOL)
end

local function confirmSlaveMove(state)
    local tx = state.tx

    for attempt = 1, LINK_ATTEMPTS do
        local reply = querySlaveTx(tx.token)

        if reply and reply.present == true then
            if reply.phase == "complete" then
                return commitMove(state)
            end

            if reply.phase == "prepared" then
                sendSlaveExecute(tx)
            end
        else
            if pingSlaveOnce() then
                if prepareSlave(tx) then
                    sendSlaveExecute(tx)
                end
            end
        end

        sleep(0.1)
    end

    recoveryFailure(
        state,
        "Drive1 slave did not confirm its movement transaction."
    )

    return false
end

local function runTransaction(state)
    local tx = state.tx

    if not tx then
        return false
    end

    local move = moves[tx.direction]

    if not move then
        recoveryFailure(state, "Unknown movement transaction.")
        return false
    end

    drawRoute(state, tx.direction)

    if tx.phase == "created" then
        if not prepareSlave(tx) then
            recoveryFailure(
                state,
                "Drive1 slave did not prepare the movement transaction."
            )
            return false
        end

        tx.phase = "prepared"
        saveMainState(state)
    end

    if move.owner == MASTER_ID then
        if tx.phase == "prepared" then
            tx.phase = "local_issued"
            saveMainState(state)

            pulseMain(move.side)

            tx.phase = "await_peer"
            saveMainState(state)
        end

        if tx.phase == "local_issued" or tx.phase == "await_peer" then
            return confirmLocalMove(state)
        end

    else
        if tx.phase == "prepared" then
            tx.phase = "remote_issued"
            saveMainState(state)
            sendSlaveExecute(tx)
        end

        if tx.phase == "remote_issued" then
            return confirmSlaveMove(state)
        end
    end

    recoveryFailure(state, "Invalid transaction phase: " .. tostring(tx.phase))
    return false
end

local function newMove(state, direction)
    local move = moves[direction]

    if not move then
        recoveryFailure(state, "Invalid direction: " .. tostring(direction))
        return
    end

    state.sequence = (state.sequence or 0) + 1

    state.tx = {
        token =
            tostring(MASTER_ID) ..
            ":" ..
            tostring(state.sequence) ..
            ":" ..
            direction,
        direction = direction,
        owner = move.owner,
        phase = "created",
        recoveryReboots = 0
    }

    saveMainState(state)
    runTransaction(state)
end


local function integerValue(value)
    local number = tonumber(value)

    if not number or number ~= math.floor(number) then
        return nil
    end

    return number
end

local function copyPosition(value)
    if type(value) ~= "table" then
        return nil
    end

    return {
        x = value.x,
        y = value.y,
        z = value.z
    }
end

local function routeActive(state)
    return
        state.stage ~= "idle" and
        state.stage ~= "arrived" and
        state.stage ~= "complete"
end

local function controlStatus(state)
    return {
        type = "status",
        ok = true,
        current = copyPosition(state.current),
        destination = copyPosition(state.destination),
        origin = copyPosition(state.start),
        cruise = state.cruise,
        stage = state.stage,
        routeMode = state.routeMode,
        paused = state.paused == true,
        active = routeActive(state),
        transaction = state.tx and {
            direction = state.tx.direction,
            phase = state.tx.phase
        } or nil
    }
end

local function sendControlReply(token, payload)
    payload = payload or {}
    payload.token = token
    payload.release = CAIRN_RELEASE

    rednet.send(
        SLAVE_ID,
        {
            type = "control_reply",
            token = token,
            payload = payload
        },
        LINK_PROTOCOL
    )
end

local function cacheControlReply(state, token, payload)
    state.lastControlToken = token
    state.lastControlReply = payload
    saveMainState(state)
end

local function beginOneWay(state, x, y, z, cruise)
    state.start = copyPosition(state.current)
    state.destination = {
        x = x,
        y = y,
        z = z
    }
    state.cruise = cruise
    state.stage = "out_climb"
    state.routeMode = "oneway"
    state.paused = false
    state.tx = nil
    saveMainState(state)
end

local function handleControl(state, message)
    local token = tostring(message.token or "")
    local command = tostring(message.command or "")

    if token == "" then
        return
    end

    if
        state.lastControlToken == token and
        state.lastControlReply
    then
        sendControlReply(
            token,
            state.lastControlReply
        )
        return
    end

    if command == "status" then
        local payload = controlStatus(state)
        cacheControlReply(state, token, payload)
        sendControlReply(token, payload)
        return
    end

    local reply = {
        type = "command_reply",
        command = command,
        ok = false
    }

    if command == "pause" then
        state.paused = true
        reply.ok = true
        reply.message = "Route paused"

    elseif command == "resume" then
        if routeActive(state) then
            state.paused = false
            reply.ok = true
            reply.message = "Route resumed"
        else
            reply.message = "No active route"
        end

    elseif command == "cancel" then
        state.paused = false
        state.stage = "idle"
        state.routeMode = "idle"
        state.tx = nil
        reply.ok = true
        reply.message = "Route cancelled"

    elseif command == "set_destination" then
        local x = integerValue(message.x)
        local y = integerValue(message.y)
        local z = integerValue(message.z)
        local cruise = integerValue(message.cruise)

        if not x or not y or not z or not cruise then
            reply.message = "Coordinates must be whole numbers"

        elseif cruise < state.current.y or cruise < y then
            reply.message = "Cruise Y is too low"

        else
            beginOneWay(
                state,
                x,
                y,
                z,
                cruise
            )

            reply.ok = true
            reply.message = "Destination accepted"
        end

    elseif command == "return_origin" then
        if not state.start then
            reply.message = "No origin stored"

        else
            local cruise =
                integerValue(message.cruise) or
                state.cruise or
                state.current.y

            if
                cruise < state.current.y or
                cruise < state.start.y
            then
                reply.message = "Cruise Y is too low"

            else
                beginOneWay(
                    state,
                    state.start.x,
                    state.start.y,
                    state.start.z,
                    cruise
                )

                reply.ok = true
                reply.message = "Return route accepted"
            end
        end

    elseif command == "set_position" then
        local x = integerValue(message.x)
        local y = integerValue(message.y)
        local z = integerValue(message.z)

        if routeActive(state) or state.tx then
            reply.message = "Cancel route before setting position"

        elseif not x or not y or not z then
            reply.message = "Coordinates must be whole numbers"

        else
            state.current = {
                x = x,
                y = y,
                z = z
            }

            state.start = copyPosition(state.current)
            state.destination = copyPosition(state.current)
            state.cruise = y
            state.stage = "idle"
            state.routeMode = "idle"
            state.paused = false

            reply.ok = true
            reply.message = "Position updated"
        end

    elseif command == "force_update" then
        state.paused = true
        reply.ok = true
        reply.message = "Platform update starting"
        pendingAction = "update"

    else
        reply.message = "Unknown command"
    end

    cacheControlReply(state, token, reply)
    sendControlReply(token, reply)
end

local function processControlQueue(state)
    while #controlQueue > 0 do
        local message = table.remove(
            controlQueue,
            1
        )

        handleControl(state, message)
    end
end

local function receiveControlRelay(timeout)
    local sender, message = rednet.receive(
        LINK_PROTOCOL,
        timeout
    )

    if
        sender == SLAVE_ID and
        type(message) == "table" and
        message.type == "control_relay" and
        type(message.message) == "table"
    then
        queueControl(message.message)
        return true
    end

    return false
end

local function controlCheckpoint(state)
    local token =
        "scan:" ..
        tostring(MASTER_ID) ..
        ":" ..
        tostring(math.floor(os.clock() * 1000))

    rednet.send(
        SLAVE_ID,
        {
            type = "control_scan",
            token = token,
            duration = CONTROL_WINDOW
        },
        LINK_PROTOCOL
    )

    local reply = waitLinkType(
        "control_scan_done",
        token,
        CONTROL_WINDOW + 0.9
    )

    processControlQueue(state)

    if not reply then
        return false
    end

    if pendingAction then
        return false
    end

    if state.paused then
        return false
    end

    return true
end

local function moveYTo(state, target)
    if state.current.y < target then
        newMove(state, "up")
        return true
    end

    if state.current.y > target then
        newMove(state, "down")
        return true
    end

    return false
end

local function moveXTo(state, target)
    if state.current.x < target then
        newMove(state, "left")
        return true
    end

    if state.current.x > target then
        newMove(state, "right")
        return true
    end

    return false
end

local function moveZTo(state, target)
    if state.current.z > target then
        newMove(state, "forward")
        return true
    end

    if state.current.z < target then
        newMove(state, "back")
        return true
    end

    return false
end

local function waitForSlaveInteractive()
    while true do
        term.clear()
        term.setCursorPos(1, 1)
        print("CAIRN DRIVE PREFLIGHT")
        print("Release v" .. CAIRN_RELEASE)
        print("")
        print("Checking Drive1 / 2701...")

        local reply = pingSlave()

        if reply then
            print("Drive1 slave online")
            print("Drive1 slave release: v" .. tostring(reply.release))
            sleep(0.75)
            return
        end

        print("")
        print("Drive1 did not answer.")
        print("Press Enter to retry.")
        read()
    end
end

local function initializeState()
    waitForSlaveInteractive()

    term.clear()
    term.setCursorPos(1, 1)

    print("CAIRN NAVIGATION")
    print("Release v" .. CAIRN_RELEASE)
    print("")
    print("Enter authoritative current coordinates")

    local x = askInteger("X")
    local y = askInteger("Y")
    local z = askInteger("Z")

    local state = {
        version = MAIN_STATE_VERSION,
        start = {
            x = x,
            y = y,
            z = z
        },
        destination = {
            x = x,
            y = y,
            z = z
        },
        cruise = y,
        current = {
            x = x,
            y = y,
            z = z
        },
        stage = "idle",
        routeMode = "idle",
        paused = false,
        sequence = 0,
        tx = nil,
        lastControlToken = nil,
        lastControlReply = nil
    }

    saveMainState(state)

    return state
end

local function advanceTrip(state)
    if state.tx then
        runTransaction(state)
        return
    end

    if state.paused then
        return
    end

    while true do
        if state.stage == "idle" or state.stage == "arrived" then
            return
        end

        if not controlCheckpoint(state) then
            return
        end

        if state.stage == "out_climb" then
            if moveYTo(state, state.cruise) then
                return
            end

            state.stage = "out_x"
            saveMainState(state)

        elseif state.stage == "out_x" then
            if moveXTo(state, state.destination.x) then
                return
            end

            state.stage = "out_z"
            saveMainState(state)

        elseif state.stage == "out_z" then
            if moveZTo(state, state.destination.z) then
                return
            end

            state.stage = "out_descend"
            saveMainState(state)

        elseif state.stage == "out_descend" then
            if moveYTo(state, state.destination.y) then
                return
            end

            if state.routeMode == "oneway" then
                state.stage = "arrived"
                state.routeMode = "idle"
                state.paused = false
                saveMainState(state)
                return
            end

            state.stage = "dwell"
            saveMainState(state)

        elseif state.stage == "dwell" then
            local remaining = 10

            while remaining > 0 do
                receiveControlRelay(0.20)
                processControlQueue(state)

                if pendingAction or state.paused then
                    return
                end

                remaining = remaining - 0.20
            end

            state.stage = "return_climb"
            saveMainState(state)

        elseif state.stage == "return_climb" then
            if moveYTo(state, state.cruise) then
                return
            end

            state.stage = "return_x"
            saveMainState(state)

        elseif state.stage == "return_x" then
            if moveXTo(state, state.start.x) then
                return
            end

            state.stage = "return_z"
            saveMainState(state)

        elseif state.stage == "return_z" then
            if moveZTo(state, state.start.z) then
                return
            end

            state.stage = "return_descend"
            saveMainState(state)

        elseif state.stage == "return_descend" then
            if moveYTo(state, state.start.y) then
                return
            end

            state.stage = "arrived"
            state.routeMode = "idle"
            state.paused = false
            saveMainState(state)
            return

        elseif state.stage == "complete" then
            state.stage = "arrived"
            state.routeMode = "idle"
            state.paused = false
            saveMainState(state)
            return

        else
            term.clear()
            term.setCursorPos(1, 1)
            print("CAIRN NAVIGATION")
            print("")
            print("Unknown route stage: " .. tostring(state.stage))
            print("Delete " .. MAIN_STATE_FILE .. " to reset.")
            return
        end
    end
end

local function receiveRemoteUpdate(firstMessage)
    local session = firstMessage.session
    local version = firstMessage.version
    local expected = firstMessage.files

    if
        type(session) ~= "string" or
        type(version) ~= "number" or
        type(expected) ~= "table"
    then
        return false, "invalid update begin"
    end

    local stage = "cairn_remote_stage"

    if fs.exists(stage) then
        fs.delete(stage)
    end

    fs.makeDir(stage)

    rednet.send(MASTER_ID, {
        type = "update_ack",
        stage = "begin",
        session = session
    }, UPDATE_PROTOCOL)

    local received = {}

    while true do
        local sender, message, protocol = rednet.receive()

        if
            sender == MASTER_ID and
            protocol == UPDATE_PROTOCOL and
            type(message) == "table" and
            message.session == session
        then
            if message.type == "file_begin" then
                local name = message.name

                if type(name) ~= "string" then
                    return false, "invalid file name"
                end

                local path = fs.combine(stage, name)

                if fs.exists(path) then
                    fs.delete(path)
                end

                local h = fs.open(path, "w")

                if not h then
                    return false, "could not create staged file"
                end

                h.close()
                received[name] = true

                rednet.send(MASTER_ID, {
                    type = "update_ack",
                    stage = "file_begin",
                    session = session,
                    name = name
                }, UPDATE_PROTOCOL)

            elseif message.type == "file_chunk" then
                local name = message.name
                local data = message.data

                if not received[name] or type(data) ~= "string" then
                    return false, "invalid file chunk"
                end

                local h = fs.open(fs.combine(stage, name), "a")

                if not h then
                    return false, "could not append staged file"
                end

                h.write(data)
                h.close()

                rednet.send(MASTER_ID, {
                    type = "update_ack",
                    stage = "file_chunk",
                    session = session,
                    name = name,
                    index = message.index
                }, UPDATE_PROTOCOL)

            elseif message.type == "file_end" then
                local name = message.name
                local path = fs.combine(stage, name)
                local fn, err = loadfile(path)

                if not fn then
                    return false, "validation failed: " .. tostring(err)
                end

                rednet.send(MASTER_ID, {
                    type = "update_ack",
                    stage = "file_end",
                    session = session,
                    name = name
                }, UPDATE_PROTOCOL)

            elseif message.type == "commit" then
                for _, name in ipairs(expected) do
                    if
                        not received[name] or
                        not fs.exists(fs.combine(stage, name))
                    then
                        return false, "missing staged file: " .. tostring(name)
                    end
                end

                for _, name in ipairs(expected) do
                    local source = fs.combine(stage, name)

                    if fs.exists(name) then
                        fs.delete(name)
                    end

                    fs.move(source, name)
                end

                if fs.exists(stage) then
                    fs.delete(stage)
                end

                local h = fs.open(".cairn_version", "w")

                if h then
                    h.write(tostring(version))
                    h.close()
                end

                rednet.send(MASTER_ID, {
                    type = "update_ack",
                    stage = "commit",
                    session = session
                }, UPDATE_PROTOCOL)

                sleep(0.5)
                os.reboot()

                return true
            end
        end
    end
end

local function slaveReply(state, messageType, token, extra)
    local payload = extra or {}

    payload.type = messageType
    payload.token = token
    payload.release = CAIRN_RELEASE
    payload.boot = state.boot

    rednet.send(MASTER_ID, payload, LINK_PROTOCOL)
end

local function slaveStatus(state, token)
    local present =
        state.tx ~= nil and
        state.tx.token == token

    slaveReply(
        state,
        "tx_status",
        token,
        {
            present = present,
            phase = present and state.tx.phase or nil,
            direction = present and state.tx.direction or nil,
            executor = present and state.tx.executor or nil
        }
    )
end

local function relayControllerMessage(message)
    if type(message) ~= "table" then
        return
    end

    local token = tostring(message.token or "")

    if token == "" then
        return
    end

    rednet.send(
        CONTROL_ID,
        {
            type = "relay_ack",
            token = token,
            release = CAIRN_RELEASE,
            message = "Drive1 received command"
        },
        CONTROL_REPLY_PROTOCOL
    )

    rednet.send(
        MASTER_ID,
        {
            type = "control_relay",
            message = message
        },
        LINK_PROTOCOL
    )
end

local function forwardControllerReply(message)
    if
        type(message) == "table" and
        type(message.payload) == "table"
    then
        rednet.send(
            CONTROL_ID,
            message.payload,
            CONTROL_REPLY_PROTOCOL
        )
    end
end

local function scanController(duration)
    local deadline = os.clock() + duration

    while os.clock() < deadline do
        local sender, message, protocol = rednet.receive(
            nil,
            deadline - os.clock()
        )

        if not sender then
            break
        end

        if
            sender == CONTROL_ID and
            protocol == CONTROL_PROTOCOL and
            type(message) == "table"
        then
            relayControllerMessage(message)

        elseif
            sender == MASTER_ID and
            protocol == LINK_PROTOCOL and
            type(message) == "table" and
            message.type == "control_reply"
        then
            forwardControllerReply(message)
        end
    end
end

local function runSlave()
    clearSlaveOutputs()

    local hardwareOk, hardwareError = checkSlaveHardware()

    if not hardwareOk then
        drawHardwareError("DRIVE1 SLAVE", hardwareError)
        return
    end

    openModem(SLAVE_WIRED_SIDE)

    local wirelessSide = findSlaveWireless()

    if not wirelessSide then
        drawHardwareError(
            "DRIVE1 SLAVE",
            "Drive1 requires a wireless modem for controller 2705."
        )
        return
    end

    openModem(wirelessSide)

    local state = loadSlaveState()

    state.boot = (state.boot or 0) + 1

    if
        state.tx and
        state.tx.executor == SLAVE_ID and
        state.tx.phase == "executing"
    then
        state.tx.phase = "complete"
        state.tx.recovered = true
    end

    saveSlaveState(state)

    term.clear()
    term.setCursorPos(1, 1)
    print("CAIRN DRIVE1 SLAVE")
    print("Release v" .. CAIRN_RELEASE)
    print("ID: " .. os.getComputerID())
    print("")
    print("Wired modem: bottom")
    print("Wireless relay: " .. wirelessSide)
    print("")
    print("Listening for controller 2705...")

    scanController(CONTROL_BOOT_WINDOW)

    term.setCursorPos(1, 9)
    term.clearLine()
    print("Waiting for Drive2 master...")

    while true do
        local sender, message, protocol = rednet.receive()

        if
            sender == CONTROL_ID and
            protocol == CONTROL_PROTOCOL and
            type(message) == "table"
        then
            relayControllerMessage(message)

        elseif
            sender == MASTER_ID and
            protocol == LINK_PROTOCOL and
            type(message) == "table"
        then
            if message.type == "ping" then
                slaveReply(
                    state,
                    "pong",
                    message.token,
                    {
                        lastToken = state.tx and state.tx.token or nil,
                        lastPhase = state.tx and state.tx.phase or nil
                    }
                )

            elseif message.type == "prepare" then
                if
                    not state.tx or
                    state.tx.token ~= message.token
                then
                    state.tx = {
                        token = message.token,
                        direction = message.direction,
                        executor = message.executor,
                        phase = "prepared",
                        preparedBoot = state.boot
                    }

                    saveSlaveState(state)
                end

                slaveReply(
                    state,
                    "prepared",
                    message.token,
                    {
                        phase = state.tx.phase
                    }
                )

            elseif message.type == "tx_status" then
                slaveStatus(state, message.token)

            elseif message.type == "execute" then
                if
                    state.tx and
                    state.tx.token == message.token and
                    state.tx.executor == SLAVE_ID and
                    slaveMoves[message.direction]
                then
                    if state.tx.phase == "complete" then
                        slaveReply(
                            state,
                            "move_complete",
                            message.token,
                            {
                                direction = message.direction
                            }
                        )

                    elseif state.tx.phase == "prepared" then
                        local move = slaveMoves[message.direction]

                        state.tx.phase = "executing"
                        saveSlaveState(state)

                        slaveReply(
                            state,
                            "execute_ack",
                            message.token,
                            {
                                direction = message.direction
                            }
                        )

                        sleep(0.15)
                        clearSlaveOutputs()
                        redstone.setOutput(move.side, true)
                        sleep(PULSE_TIME)
                        redstone.setOutput(move.side, false)
                        sleep(MOVE_SETTLE_TIME)

                        state.tx.phase = "complete"
                        saveSlaveState(state)

                        slaveReply(
                            state,
                            "move_complete",
                            message.token,
                            {
                                direction = message.direction
                            }
                        )

                    elseif state.tx.phase == "executing" then
                        slaveReply(
                            state,
                            "execute_ack",
                            message.token,
                            {
                                direction = message.direction
                            }
                        )
                    end
                end

            elseif message.type == "commit" then
                if state.tx and state.tx.token == message.token then
                    state.tx = nil
                    saveSlaveState(state)
                end

                slaveReply(
                    state,
                    "commit_ack",
                    message.token
                )

            elseif message.type == "control_scan" then
                term.setCursorPos(1, 9)
                term.clearLine()
                print("Scanning controller 2705...")

                scanController(
                    tonumber(message.duration) or CONTROL_WINDOW
                )

                slaveReply(
                    state,
                    "control_scan_done",
                    message.token
                )

                term.setCursorPos(1, 9)
                term.clearLine()
                print("Waiting for Drive2 master...")

            elseif message.type == "control_reply" then
                forwardControllerReply(message)
            end

        elseif
            sender == MASTER_ID and
            protocol == UPDATE_PROTOCOL and
            type(message) == "table" and
            message.type == "update_begin"
        then
            local success, updateError = receiveRemoteUpdate(message)

            if not success then
                pcall(function()
                    rednet.send(MASTER_ID, {
                        type = "update_error",
                        session = message.session,
                        error = tostring(updateError)
                    }, UPDATE_PROTOCOL)
                end)

                if fs.exists("cairn_remote_stage") then
                    fs.delete("cairn_remote_stage")
                end
            end
        end
    end
end

local function runMain()
    clearMainOutputs()

    local hardwareOk, hardwareError = checkMainHardware()

    if not hardwareOk then
        drawHardwareError("DRIVE2 MASTER", hardwareError)
        return
    end

    openModem(MASTER_WIRED_SIDE)

    local state = loadMainState()

    if not state then
        state = initializeState()
    end

    while true do
        receiveControlRelay(0.05)
        processControlQueue(state)

        if pendingAction == "update" then
            pendingAction = nil
            shell.run("update")
        end

        if state.paused or not routeActive(state) then
            drawRoute(state)

            print("")

            if state.paused then
                print("PAUSED - waiting for controller 2705")
            else
                print("Waiting for controller 2705")
            end

            receiveControlRelay(0.45)
            processControlQueue(state)

        else
            advanceTrip(state)
        end

        if pendingAction == "update" then
            pendingAction = nil
            shell.run("update")
        end

        sleep(0.02)
    end
end

local id = os.getComputerID()

migrateLegacyState()

if id == MASTER_ID then
    runMain()
elseif id == SLAVE_ID then
    runSlave()
else
    term.clear()
    term.setCursorPos(1, 1)
    print("CAIRN DRIVE")
    print("")
    print("Unexpected computer ID: " .. id)
    print("Expected Drive2 = 2700")
    print("Expected Drive1 = 2701")
end
