local CAIRN_RELEASE = 15

local MAIN_ID = 2700
local FOLLOWER_ID = 2701

local LINK_PROTOCOL = "cairn.drive.link"
local COMMAND_PROTOCOL = "cairn.drive.command"
local REPLY_PROTOCOL = "cairn.drive.reply"
local UPDATE_PROTOCOL = "cairn.drive.update"

local STATE_FILE = ".cairn_drive_state"
local STATE_VERSION = 5
local REBOOT_TIMEOUT = 3
local FOLLOWER_ACK_TIMEOUT = 2

local SIDES = {
    "top",
    "bottom",
    "left",
    "right",
    "front",
    "back"
}

local mainMoves = {
    forward = {side = "back", dx = 0, dy = 0, dz = -1},
    up = {side = "bottom", dx = 0, dy = 1, dz = 0}
}

local followerMoves = {
    left = {side = "right", dx = -1, dy = 0, dz = 0},
    right = {side = "left", dx = 1, dy = 0, dz = 0},
    back = {side = "back", dx = 0, dy = 0, dz = 1},
    down = {side = "top", dx = 0, dy = -1, dz = 0}
}

local allMoves = {
    forward = {owner = MAIN_ID, side = "back", dx = 0, dy = 0, dz = -1},
    up = {owner = MAIN_ID, side = "bottom", dx = 0, dy = 1, dz = 0},
    left = {owner = FOLLOWER_ID, side = "right", dx = -1, dy = 0, dz = 0},
    right = {owner = FOLLOWER_ID, side = "left", dx = 1, dy = 0, dz = 0},
    back = {owner = FOLLOWER_ID, side = "back", dx = 0, dy = 0, dz = 1},
    down = {owner = FOLLOWER_ID, side = "top", dx = 0, dy = -1, dz = 0}
}

local testSequences = {
    [1] = {
        {direction = "up", count = 3},
        {direction = "forward", count = 3},
        {direction = "back", count = 6},
        {direction = "forward", count = 3},
        {direction = "down", count = 3}
    },
    [2] = {
        {direction = "up", count = 5},
        {direction = "forward", count = 10},
        {direction = "left", count = 10},
        {direction = "back", count = 10},
        {direction = "right", count = 10},
        {direction = "down", count = 5}
    }
}

local function findWiredModem()
    for _, side in ipairs(SIDES) do
        if peripheral.getType(side) == "modem" then
            local ok, wireless = pcall(peripheral.call, side, "isWireless")
            if ok and wireless == false then
                return side
            end
        end
    end
    return nil
end

local function openModem(side)
    if side and peripheral.getType(side) == "modem" then
        if not rednet.isOpen(side) then
            rednet.open(side)
        end
        return true
    end
    return false
end

local function clearMainOutputs()
    redstone.setOutput("back", false)
    redstone.setOutput("bottom", false)
end

local function clearFollowerOutputs()
    redstone.setOutput("right", false)
    redstone.setOutput("left", false)
    redstone.setOutput("back", false)
    redstone.setOutput("top", false)
end

local function defaultState()
    return {
        version = STATE_VERSION,
        x = 0,
        y = 0,
        z = 0,
        phase = "idle",
        direction = nil,
        mode = nil,
        queue = {},
        index = 1,
        returnAfter = false,
        requester = nil
    }
end

local function saveState(state)
    local h = fs.open(STATE_FILE, "w")
    if not h then
        return false
    end
    h.write(textutils.serialize(state))
    h.close()
    return true
end

local function loadState()
    if not fs.exists(STATE_FILE) then
        return defaultState()
    end

    local h = fs.open(STATE_FILE, "r")
    if not h then
        return defaultState()
    end

    local raw = h.readAll()
    h.close()

    local state = textutils.unserialize(raw)

    if type(state) ~= "table" or state.version ~= STATE_VERSION then
        state = defaultState()
        saveState(state)
    end

    return state
end

local function atIdle(state)
    return state.x == 0 and state.y == 0 and state.z == 0
end

local function buildTest(number)
    local queue = {}

    for _, segment in ipairs(testSequences[number]) do
        for i = 1, segment.count do
            queue[#queue + 1] = segment.direction
        end
    end

    return queue
end

local function finishArmedMove(state)
    if state.phase ~= "armed" or not state.direction then
        return
    end

    local move = allMoves[state.direction]

    if not move then
        state.phase = "idle"
        state.direction = nil
        saveState(state)
        return
    end

    state.x = state.x + move.dx
    state.y = state.y + move.dy
    state.z = state.z + move.dz
    state.index = state.index + 1
    state.phase = "idle"
    state.direction = nil
    saveState(state)
end

local function nextReturnMove(state)
    if state.y < 0 then
        return "up"
    end

    if state.x > 0 then
        return "left"
    end

    if state.x < 0 then
        return "right"
    end

    if state.z > 0 then
        return "forward"
    end

    if state.z < 0 then
        return "back"
    end

    if state.y > 0 then
        return "down"
    end

    return nil
end

local function sendReply(id, message)
    if id then
        rednet.send(id, message, REPLY_PROTOCOL)
    end
end

local function waitForFollowerAck(token)
    local deadline = os.clock() + FOLLOWER_ACK_TIMEOUT

    while os.clock() < deadline do
        local remaining = deadline - os.clock()
        local sender, message, protocol = rednet.receive(LINK_PROTOCOL, remaining)

        if not sender then
            return false
        end

        if sender == FOLLOWER_ID and type(message) == "table" then
            if message.type == "move_ack" and message.token == token then
                return true
            end
        end
    end

    return false
end

local function pingFollower()
    local token = tostring(os.getComputerID()) .. ":" .. tostring(math.floor(os.clock() * 1000))

    rednet.send(FOLLOWER_ID, {
        type = "ping",
        token = token
    }, LINK_PROTOCOL)

    local deadline = os.clock() + 1.5

    while os.clock() < deadline do
        local remaining = deadline - os.clock()
        local sender, message = rednet.receive(LINK_PROTOCOL, remaining)

        if not sender then
            return false
        end

        if sender == FOLLOWER_ID and type(message) == "table" then
            if message.type == "pong" and message.token == token then
                return true
            end
        end
    end

    return false
end

local function showMoveScreen(state, direction)
    local move = allMoves[direction]

    term.clear()
    term.setCursorPos(1, 1)

    print("CAIRN DRIVE")
    print("Release v" .. CAIRN_RELEASE)
    print("")
    print("Authoritative node: Drive2 / 2700")
    print("")
    print("Relative position")
    print("X: " .. state.x .. "  Y: " .. state.y .. "  Z: " .. state.z)
    print("")
    print("Moving: " .. string.upper(direction))

    if move.owner == MAIN_ID then
        print("Executor: Drive2")
    else
        print("Executor: Drive1")
    end

    print("Output side: " .. move.side)
    print("")
    print("Waiting for carriage movement...")
end

local function abortArmedMove(state, message)
    state.phase = "idle"
    state.direction = nil
    state.mode = nil
    state.queue = {}
    state.index = 1
    state.returnAfter = false
    saveState(state)

    term.clear()
    term.setCursorPos(1, 1)
    print("CAIRN DRIVE")
    print("")
    print(message)
    print("")
    print("Movement queue aborted")
    sleep(2)
end

local function issueMove(state, direction)
    local move = allMoves[direction]

    if not move then
        abortArmedMove(state, "Unknown movement command")
        return false
    end

    local ok, err = pcall(clearMainOutputs)

    if not ok then
        abortArmedMove(state, "Could not clear Drive2 outputs: " .. tostring(err))
        return false
    end

    state.phase = "armed"
    state.direction = direction

    if not saveState(state) then
        abortArmedMove(state, "Could not save movement state")
        return false
    end

    showMoveScreen(state, direction)

    if move.owner == MAIN_ID then
        ok, err = pcall(redstone.setOutput, move.side, true)

        if not ok then
            abortArmedMove(state, "Drive2 output failed: " .. tostring(err))
            return false
        end
    else
        local token =
            tostring(os.getComputerID()) ..
            ":" ..
            tostring(state.index) ..
            ":" ..
            tostring(math.floor(os.clock() * 1000))

        rednet.send(FOLLOWER_ID, {
            type = "move",
            token = token,
            direction = direction
        }, LINK_PROTOCOL)

        if not waitForFollowerAck(token) then
            abortArmedMove(state, "Drive1 did not acknowledge movement")
            return false
        end
    end

    sleep(REBOOT_TIMEOUT)

    pcall(clearMainOutputs)

    state.phase = "idle"
    state.direction = nil
    state.mode = nil
    state.queue = {}
    state.index = 1
    state.returnAfter = false
    saveState(state)

    term.clear()
    term.setCursorPos(1, 1)
    print("CAIRN DRIVE")
    print("")
    print("No carriage reboot detected")
    print("Movement was not recorded")
    print("Queue aborted")
    sleep(2)

    return false
end

local function beginQueue(state, mode, queue, returnAfter, requester)
    state.mode = mode
    state.queue = queue
    state.index = 1
    state.returnAfter = returnAfter == true
    state.requester = requester
    state.phase = "idle"
    state.direction = nil
    saveState(state)
end

local function completeQueue(state)
    local requester = state.requester
    local mode = state.mode

    if state.returnAfter and not atIdle(state) then
        state.mode = "return"
        state.queue = {}
        state.index = 1
        state.returnAfter = false
        saveState(state)
        return true
    end

    state.mode = nil
    state.queue = {}
    state.index = 1
    state.returnAfter = false
    state.requester = nil
    saveState(state)

    if requester then
        sendReply(requester, {
            ok = true,
            type = "complete",
            mode = mode,
            x = state.x,
            y = state.y,
            z = state.z
        })
    end

    return false
end

local function processActive(state)
    if state.mode == "return" then
        local direction = nextReturnMove(state)

        if direction then
            issueMove(state, direction)
            return
        end

        completeQueue(state)
        return
    end

    if state.index <= #state.queue then
        issueMove(state, state.queue[state.index])
        return
    end

    completeQueue(state)
end

local function normalizeDirection(value)
    if type(value) ~= "string" then
        return nil
    end

    value = string.lower(value)

    if allMoves[value] then
        return value
    end

    if value == "backward" or value == "backwards" then
        return "back"
    end

    return nil
end

local function statusPayload(state, followerOnline, wiredSide)
    return {
        ok = true,
        type = "status",
        release = CAIRN_RELEASE,
        id = MAIN_ID,
        label = "Drive2",
        follower = FOLLOWER_ID,
        followerOnline = followerOnline,
        wiredSide = wiredSide,
        busy = state.mode ~= nil,
        mode = state.mode,
        x = state.x,
        y = state.y,
        z = state.z
    }
end

local function handleWirelessCommand(sender, message, state, followerOnline, wiredSide)
    if sender == FOLLOWER_ID then
        return false
    end

    if type(message) == "string" then
        local direction = normalizeDirection(message)

        if direction then
            if state.mode ~= nil then
                sendReply(sender, {ok = false, error = "busy"})
                return false
            end

            beginQueue(state, "external", {direction}, false, sender)
            sendReply(sender, {ok = true, type = "accepted", count = 1})
            return true
        end

        if string.lower(message) == "status" then
            sendReply(sender, statusPayload(state, followerOnline, wiredSide))
            return false
        end
    end

    if type(message) ~= "table" then
        sendReply(sender, {ok = false, error = "invalid command"})
        return false
    end

    local command = message.command or message.type

    if command == "status" then
        sendReply(sender, statusPayload(state, followerOnline, wiredSide))
        return false
    end

    if command == "return" then
        if state.mode ~= nil then
            sendReply(sender, {ok = false, error = "busy"})
            return false
        end

        if atIdle(state) then
            sendReply(sender, {ok = true, type = "complete", x = 0, y = 0, z = 0})
            return false
        end

        state.mode = "return"
        state.queue = {}
        state.index = 1
        state.returnAfter = false
        state.requester = sender
        saveState(state)
        sendReply(sender, {ok = true, type = "accepted"})
        return true
    end

    if command == "test" then
        local number = tonumber(message.number)

        if number ~= 1 and number ~= 2 then
            sendReply(sender, {ok = false, error = "invalid test"})
            return false
        end

        if state.mode ~= nil then
            sendReply(sender, {ok = false, error = "busy"})
            return false
        end

        if not atIdle(state) then
            sendReply(sender, {ok = false, error = "not at idle"})
            return false
        end

        beginQueue(state, "test" .. number, buildTest(number), true, sender)
        sendReply(sender, {ok = true, type = "accepted"})
        return true
    end

    if command == "move" then
        if state.mode ~= nil then
            sendReply(sender, {ok = false, error = "busy"})
            return false
        end

        local queue = {}

        if type(message.moves) == "table" then
            for _, value in ipairs(message.moves) do
                local direction = normalizeDirection(value)

                if not direction then
                    sendReply(sender, {ok = false, error = "invalid direction"})
                    return false
                end

                queue[#queue + 1] = direction
            end
        else
            local direction = normalizeDirection(message.direction)

            if not direction then
                sendReply(sender, {ok = false, error = "invalid direction"})
                return false
            end

            local count = tonumber(message.count) or 1
            count = math.floor(count)

            if count < 1 or count > 4096 then
                sendReply(sender, {ok = false, error = "invalid count"})
                return false
            end

            for i = 1, count do
                queue[#queue + 1] = direction
            end
        end

        if #queue == 0 then
            sendReply(sender, {ok = false, error = "empty movement queue"})
            return false
        end

        beginQueue(
            state,
            "external",
            queue,
            message.returnAfter == true,
            sender
        )

        sendReply(sender, {
            ok = true,
            type = "accepted",
            count = #queue
        })

        return true
    end

    sendReply(sender, {ok = false, error = "unknown command"})
    return false
end

local function drawMainMenu(state, followerOnline, wiredSide, wirelessOnline)
    term.clear()
    term.setCursorPos(1, 1)

    print("CAIRN DRIVE CONTROL")
    print("Release v" .. CAIRN_RELEASE)
    print("")
    print("Drive2  ID 2700  MAIN")
    print("Drive1  ID 2701  FOLLOWER")
    print("")
    print("Wired: " .. (wiredSide or "NOT FOUND"))
    print("Wireless top: " .. (wirelessOnline and "ONLINE" or "OFFLINE"))
    print("Drive1: " .. (followerOnline and "ONLINE" or "OFFLINE"))
    print("")
    print("Position")
    print("X: " .. state.x .. "  Y: " .. state.y .. "  Z: " .. state.z)
    print("")
    print("1 - Short movement test")
    print("2 - Full movement test")

    if not atIdle(state) then
        print("R - Return to idle")
    end

    print("P - Ping Drive1")
    print("U - Update both drive computers")
    print("Q - Exit")
    print("")
    print("Wireless commands remain enabled")
end

local function receiveRemoteUpdate(firstMessage)
    local session = firstMessage.session
    local version = firstMessage.version
    local expected = firstMessage.files

    if type(session) ~= "string" or type(version) ~= "number" or type(expected) ~= "table" then
        return false, "invalid update begin"
    end

    local stage = ".cairn_remote_stage"

    if fs.exists(stage) then
        fs.delete(stage)
    end

    fs.makeDir(stage)

    rednet.send(MAIN_ID, {
        type = "update_ack",
        stage = "begin",
        session = session
    }, UPDATE_PROTOCOL)

    local received = {}

    while true do
        local sender, message, protocol = rednet.receive()

        if sender == MAIN_ID and protocol == UPDATE_PROTOCOL and type(message) == "table" then
            if message.session == session then
                if message.type == "file_begin" then
                    local name = message.name

                    if type(name) ~= "string" then
                        return false, "invalid file name"
                    end

                    local path = fs.combine(stage, name)

                    if fs.exists(path) then
                        fs.delete(path)
                    end

                    local h = fs.open(path, "w")

                    if not h then
                        return false, "could not create staged file"
                    end

                    h.close()
                    received[name] = true

                    rednet.send(MAIN_ID, {
                        type = "update_ack",
                        stage = "file_begin",
                        session = session,
                        name = name
                    }, UPDATE_PROTOCOL)

                elseif message.type == "file_chunk" then
                    local name = message.name
                    local data = message.data

                    if not received[name] or type(data) ~= "string" then
                        return false, "invalid file chunk"
                    end

                    local h = fs.open(fs.combine(stage, name), "a")

                    if not h then
                        return false, "could not append staged file"
                    end

                    h.write(data)
                    h.close()

                    rednet.send(MAIN_ID, {
                        type = "update_ack",
                        stage = "file_chunk",
                        session = session,
                        name = name,
                        index = message.index
                    }, UPDATE_PROTOCOL)

                elseif message.type == "file_end" then
                    local name = message.name
                    local path = fs.combine(stage, name)
                    local fn, err = loadfile(path)

                    if not fn then
                        return false, "validation failed: " .. tostring(err)
                    end

                    rednet.send(MAIN_ID, {
                        type = "update_ack",
                        stage = "file_end",
                        session = session,
                        name = name
                    }, UPDATE_PROTOCOL)

                elseif message.type == "commit" then
                    for _, name in ipairs(expected) do
                        if not received[name] or not fs.exists(fs.combine(stage, name)) then
                            return false, "missing staged file: " .. tostring(name)
                        end
                    end

                    for _, name in ipairs(expected) do
                        local source = fs.combine(stage, name)

                        if fs.exists(name) then
                            fs.delete(name)
                        end

                        fs.move(source, name)
                    end

                    if fs.exists(stage) then
                        fs.delete(stage)
                    end

                    local h = fs.open(".cairn_version", "w")

                    if h then
                        h.write(tostring(version))
                        h.close()
                    end

                    rednet.send(MAIN_ID, {
                        type = "update_ack",
                        stage = "commit",
                        session = session
                    }, UPDATE_PROTOCOL)

                    sleep(0.5)
                    os.reboot()
                    return true
                end
            end
        end
    end
end

local function runFollower()
    local wiredSide = findWiredModem()

    term.clear()
    term.setCursorPos(1, 1)

    print("CAIRN DRIVE1")
    print("Release v" .. CAIRN_RELEASE)
    print("ID: " .. os.getComputerID())
    print("")

    local ok, err = pcall(clearFollowerOutputs)

    if not ok then
        print("Output initialization failed")
        print(tostring(err))
        return
    end

    if not wiredSide then
        print("No wired modem found")
        return
    end

    openModem(wiredSide)

    print("Wired modem: " .. wiredSide)
    print("Waiting for Drive2...")

    while true do
        local sender, message, protocol = rednet.receive()

        if sender == MAIN_ID and type(message) == "table" then
            if protocol == LINK_PROTOCOL then
                if message.type == "ping" then
                    rednet.send(MAIN_ID, {
                        type = "pong",
                        token = message.token,
                        release = CAIRN_RELEASE
                    }, LINK_PROTOCOL)

                elseif message.type == "move" then
                    local direction = message.direction
                    local move = followerMoves[direction]

                    if move then
                        clearFollowerOutputs()

                        rednet.send(MAIN_ID, {
                            type = "move_ack",
                            token = message.token,
                            direction = direction
                        }, LINK_PROTOCOL)

                        sleep(0.2)
                        redstone.setOutput(move.side, true)
                        sleep(REBOOT_TIMEOUT)
                        clearFollowerOutputs()
                    else
                        rednet.send(MAIN_ID, {
                            type = "move_reject",
                            token = message.token
                        }, LINK_PROTOCOL)
                    end
                end

            elseif protocol == UPDATE_PROTOCOL and message.type == "update_begin" then
                local success, updateErr = receiveRemoteUpdate(message)

                if not success then
                    pcall(function()
                        rednet.send(MAIN_ID, {
                            type = "update_error",
                            session = message.session,
                            error = tostring(updateErr)
                        }, UPDATE_PROTOCOL)
                    end)

                    if fs.exists(".cairn_remote_stage") then
                        fs.delete(".cairn_remote_stage")
                    end
                end
            end
        end
    end
end

local function runMain()
    local wiredSide = findWiredModem()
    local wirelessOnline = false

    local ok, err = pcall(clearMainOutputs)

    if not ok then
        print("Drive2 output initialization failed")
        print(tostring(err))
        return
    end

    if wiredSide then
        openModem(wiredSide)
    end

    if peripheral.getType("top") == "modem" then
        local wirelessOk, wireless = pcall(peripheral.call, "top", "isWireless")

        if wirelessOk and wireless == true then
            openModem("top")
            wirelessOnline = true
        end
    end

    local state = loadState()

    if state.phase == "armed" then
        finishArmedMove(state)
    end

    local followerOnline = false

    if wiredSide then
        followerOnline = pingFollower()
    end

    while true do
        state = loadState()

        if state.mode ~= nil then
            processActive(state)
        else
            drawMainMenu(state, followerOnline, wiredSide, wirelessOnline)

            local event, p1, p2, p3 = os.pullEvent()

            if event == "char" then
                local choice = string.lower(p1)

                if choice == "1" then
                    if not atIdle(state) then
                        term.setCursorPos(1, 19)
                        print("Return to idle before running test")
                        sleep(1.5)
                    else
                        beginQueue(state, "test1", buildTest(1), true, nil)
                    end

                elseif choice == "2" then
                    if not atIdle(state) then
                        term.setCursorPos(1, 19)
                        print("Return to idle before running test")
                        sleep(1.5)
                    else
                        beginQueue(state, "test2", buildTest(2), true, nil)
                    end

                elseif choice == "r" and not atIdle(state) then
                    state.mode = "return"
                    state.queue = {}
                    state.index = 1
                    state.returnAfter = false
                    state.requester = nil
                    saveState(state)

                elseif choice == "p" then
                    followerOnline = wiredSide and pingFollower() or false

                elseif choice == "u" then
                    shell.run("update")

                elseif choice == "q" then
                    clearMainOutputs()
                    term.clear()
                    term.setCursorPos(1, 1)
                    print("CAIRN Drive2 offline")
                    return
                end

            elseif event == "rednet_message" then
                local sender = p1
                local message = p2
                local protocol = p3

                if protocol == COMMAND_PROTOCOL and sender ~= FOLLOWER_ID then
                    local started = handleWirelessCommand(
                        sender,
                        message,
                        state,
                        followerOnline,
                        wiredSide
                    )

                    if started then
                        followerOnline = wiredSide and pingFollower() or false
                    end
                end
            end
        end
    end
end

local id = os.getComputerID()

if id == MAIN_ID then
    runMain()
elseif id == FOLLOWER_ID then
    runFollower()
else
    term.clear()
    term.setCursorPos(1, 1)
    print("CAIRN DRIVE")
    print("")
    print("Unexpected computer ID: " .. id)
    print("Expected Drive2 = 2700")
    print("Expected Drive1 = 2701")
end
