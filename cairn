local CAIRN_RELEASE = 28

local MASTER_ID = 2700
local SLAVE_ID = 2701
local CONTROL_ID = 2705

local LINK_PROTOCOL = "cairn.drive.link"
local COMMAND_PROTOCOL = "cairn.drive.command"
local UPDATE_PROTOCOL = "cairn.drive.update"
local CONTROL_PROTOCOL = "cairn.nav.command"
local CONTROL_REPLY_PROTOCOL = "cairn.nav.reply"

local MAIN_STATE_FILE = "cairn_drive_state"
local SLAVE_STATE_FILE = "cairn_drive1_state"
local LEGACY_MAIN_STATE_FILE = ".cairn_drive.tmp"
local LEGACY_SLAVE_STATE_FILE = ".cairn_drive1.tmp"

local MAIN_STATE_VERSION = 6
local SLAVE_STATE_VERSION = 4

local MASTER_WIRED_SIDE = "left"
local MASTER_WIRELESS_SIDE = "top"
local SLAVE_WIRED_SIDE = "bottom"

local PULSE_TIME = 0.25
local MOVE_SETTLE_TIME = 0.25
local LINK_TIMEOUT = 0.5
local LINK_ATTEMPTS = 3
local MAX_RECOVERY_REBOOTS = 3
local CONTROL_WINDOW = 0.30
local CONTROL_BOOT_WINDOW = 1.25

local controlQueue = {}
local pendingAction = nil

local moves = {
    forward = {
        owner = MASTER_ID,
        side = "back",
