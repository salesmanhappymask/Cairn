        dz = -1,
        world = "North"
    },
    back = {
        owner = MASTER_ID,
        side = "front",
        dx = 0,
        dy = 0,
        dz = 1,
        world = "South"
    },
    left = {
        owner = MASTER_ID,
        side = "right",
        dx = 1,
        dy = 0,
        dz = 0,
        world = "East"
    },
    right = {
        owner = SLAVE_ID,
        side = "left",
        dx = -1,
        dy = 0,
        dz = 0,
        world = "West"
    },
    up = {
        owner = MASTER_ID,
        side = "bottom",
        dx = 0,
        dy = 1,
