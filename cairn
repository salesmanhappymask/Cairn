local CAIRN_RELEASE = 17

local MAIN_ID = 2700
local FOLLOWER_ID = 2701

local LINK_PROTOCOL = "cairn.drive.link"
local UPDATE_PROTOCOL = "cairn.drive.update"

local TMP_FILE = ".cairn_drive.tmp"
local STATE_VERSION = 1
local REBOOT_TIMEOUT = 3

local SIDES = {
    "top",
    "bottom",
    "left",
    "right",
    "front",
    "back"
}

local moves = {
    forward = {owner = MAIN_ID, side = "back", dx = 0, dy = 0, dz = 1},
    back = {owner = FOLLOWER_ID, side = "back", dx = 0, dy = 0, dz = -1},
    left = {owner = FOLLOWER_ID, side = "right", dx = 1, dy = 0, dz = 0},
    right = {owner = FOLLOWER_ID, side = "left", dx = -1, dy = 0, dz = 0},
    up = {owner = MAIN_ID, side = "bottom", dx = 0, dy = 1, dz = 0},
    down = {owner = FOLLOWER_ID, side = "top", dx = 0, dy = -1, dz = 0}
}

local followerMoves = {
    left = moves.left,
    right = moves.right,
    back = moves.back,
    down = moves.down
}

local function findWiredModem()
    for _, side in ipairs(SIDES) do
        if peripheral.getType(side) == "modem" then
            local ok, wireless = pcall(peripheral.call, side, "isWireless")
            if ok and wireless == false then
                return side
            end
        end
    end
    return nil
end

local function openModem(side)
    if side and peripheral.getType(side) == "modem" then
        if not rednet.isOpen(side) then
            rednet.open(side)
        end
        return true
    end
    return false
end

local function clearMainOutputs()
    redstone.setOutput("back", false)
    redstone.setOutput("bottom", false)
end

local function clearFollowerOutputs()
    redstone.setOutput("right", false)
    redstone.setOutput("left", false)
    redstone.setOutput("back", false)
    redstone.setOutput("top", false)
end

local function saveState(state)
    local h = fs.open(TMP_FILE, "w")
    if not h then
        return false
    end
    h.write(textutils.serialize(state))
    h.close()
    return true
end

local function loadState()
    if not fs.exists(TMP_FILE) then
        return nil
    end

    local h = fs.open(TMP_FILE, "r")
    if not h then
        return nil
    end

    local raw = h.readAll()
    h.close()

    local state = textutils.unserialize(raw)

    if type(state) ~= "table" or state.version ~= STATE_VERSION then
        return nil
    end

    return state
end

local function askInteger(label)
    while true do
        write(label .. ": ")
        local value = read()
        local number = tonumber(value)

        if number and number == math.floor(number) then
            return number
        end

        print("Please enter a whole-number coordinate.")
    end
end

local function newTrip()
    term.clear()
    term.setCursorPos(1, 1)

    print("CAIRN NAVIGATION")
    print("Release v" .. CAIRN_RELEASE)
    print("")
    print("Enter current coordinates")

    local sx = askInteger("X")
    local sy = askInteger("Y")
    local sz = askInteger("Z")

    print("")
    print("Enter destination coordinates")

    local dx = askInteger("X")
    local dy = askInteger("Y")
    local dz = askInteger("Z")

    print("")

    local cruise

    while true do
        cruise = askInteger("Cruise altitude Y")

        if cruise >= sy and cruise >= dy then
            break
        end

        print("Cruise altitude must be at or above both current and destination Y.")
    end

    local state = {
        version = STATE_VERSION,
        start = {x = sx, y = sy, z = sz},
        destination = {x = dx, y = dy, z = dz},
        cruise = cruise,
        current = {x = sx, y = sy, z = sz},
        stage = "out_climb",
        armed = nil,
        paused = false,
        error = nil
    }

    saveState(state)
    return state
end

local function finishArmedMove(state)
    if not state.armed then
        return
    end

    local move = moves[state.armed]

    if not move then
        state.armed = nil
        state.paused = true
        state.error = "Unknown armed movement"
        saveState(state)
        return
    end

    state.current.x = state.current.x + move.dx
    state.current.y = state.current.y + move.dy
    state.current.z = state.current.z + move.dz
    state.armed = nil
    state.paused = false
    state.error = nil
    saveState(state)
end

local function drawStatus(state, action)
    term.clear()
    term.setCursorPos(1, 1)

    print("CAIRN NAVIGATION")
    print("Release v" .. CAIRN_RELEASE)
    print("")
    print("Current")
    print("X " .. state.current.x .. "   Y " .. state.current.y .. "   Z " .. state.current.z)
    print("")
    print("Destination")
    print("X " .. state.destination.x .. "   Y " .. state.destination.y .. "   Z " .. state.destination.z)
    print("")
    print("Cruise altitude: " .. state.cruise)
    print("Stage: " .. state.stage)

    if action then
        print("Movement: " .. string.upper(action))
    end
end

local function waitForFollower(timeout)
    local deadline = os.clock() + timeout
    local attempt = 0

    while os.clock() < deadline do
        attempt = attempt + 1

        local token =
            tostring(os.getComputerID()) ..
            ":" ..
            tostring(attempt) ..
            ":" ..
            tostring(math.floor(os.clock() * 1000))

        rednet.send(FOLLOWER_ID, {
            type = "ping",
            token = token
        }, LINK_PROTOCOL)

        local untilTime = math.min(deadline, os.clock() + 0.75)

        while os.clock() < untilTime do
            local sender, message = rednet.receive(LINK_PROTOCOL, untilTime - os.clock())

            if sender == FOLLOWER_ID and type(message) == "table" then
                if message.type == "pong" and message.token == token then
                    return true
                end
            end
        end
    end

    return false
end

local function waitForMoveAck(token, timeout)
    local deadline = os.clock() + timeout

    while os.clock() < deadline do
        local sender, message = rednet.receive(LINK_PROTOCOL, deadline - os.clock())

        if sender == FOLLOWER_ID and type(message) == "table" then
            if message.type == "move_ack" and message.token == token then
                return true
            end
        end
    end

    return false
end

local function pauseTrip(state, message)
    state.armed = nil
    state.paused = true
    state.error = message
    saveState(state)

    term.clear()
    term.setCursorPos(1, 1)
    print("CAIRN NAVIGATION")
    print("")
    print(message)
    print("")
    print("Trip paused.")
    print("Press Enter to retry or type CANCEL to discard the trip.")

    local response = string.lower(read() or "")

    if response == "cancel" then
        if fs.exists(TMP_FILE) then
            fs.delete(TMP_FILE)
        end
        os.reboot()
    end

    state.paused = false
    state.error = nil
    saveState(state)
end

local function issueMove(state, direction)
    local move = moves[direction]

    if not move then
        pauseTrip(state, "Invalid movement: " .. tostring(direction))
        return
    end

    clearMainOutputs()

    state.armed = direction
    state.paused = false
    state.error = nil

    if not saveState(state) then
        error("Could not save " .. TMP_FILE)
    end

    drawStatus(state, direction)

    if move.owner == MAIN_ID then
        redstone.setOutput(move.side, true)
    else
        if not waitForFollower(5) then
            pauseTrip(state, "Drive1 / 2701 is not responding.")
            return
        end

        local token =
            tostring(os.getComputerID()) ..
            ":" ..
            direction ..
            ":" ..
            tostring(math.floor(os.clock() * 1000))

        rednet.send(FOLLOWER_ID, {
            type = "move",
            token = token,
            direction = direction
        }, LINK_PROTOCOL)

        if not waitForMoveAck(token, 2) then
            pauseTrip(state, "Drive1 did not acknowledge " .. direction .. ".")
            return
        end
    end

    sleep(REBOOT_TIMEOUT)

    clearMainOutputs()

    state.armed = nil
    state.paused = true
    state.error = "No carriage reboot detected. Movement was not recorded."
    saveState(state)

    pauseTrip(state, state.error)
end

local function moveYTo(state, target)
    if state.current.y < target then
        issueMove(state, "up")
        return true
    elseif state.current.y > target then
        issueMove(state, "down")
        return true
    end

    return false
end

local function moveXTo(state, target)
    if state.current.x < target then
        issueMove(state, "left")
        return true
    elseif state.current.x > target then
        issueMove(state, "right")
        return true
    end

    return false
end

local function moveZTo(state, target)
    if state.current.z < target then
        issueMove(state, "forward")
        return true
    elseif state.current.z > target then
        issueMove(state, "back")
        return true
    end

    return false
end

local function advanceTrip(state)
    while true do
        if state.stage == "out_climb" then
            if moveYTo(state, state.cruise) then
                return
            end
            state.stage = "out_x"
            saveState(state)

        elseif state.stage == "out_x" then
            if moveXTo(state, state.destination.x) then
                return
            end
            state.stage = "out_z"
            saveState(state)

        elseif state.stage == "out_z" then
            if moveZTo(state, state.destination.z) then
                return
            end
            state.stage = "out_descend"
            saveState(state)

        elseif state.stage == "out_descend" then
            if moveYTo(state, state.destination.y) then
                return
            end
            state.stage = "dwell"
            saveState(state)

        elseif state.stage == "dwell" then
            drawStatus(state)
            print("")
            print("Destination reached.")
            print("Waiting 10 seconds before return...")
            sleep(10)
            state.stage = "return_climb"
            saveState(state)

        elseif state.stage == "return_climb" then
            if moveYTo(state, state.cruise) then
                return
            end
            state.stage = "return_x"
            saveState(state)

        elseif state.stage == "return_x" then
            if moveXTo(state, state.start.x) then
                return
            end
            state.stage = "return_z"
            saveState(state)

        elseif state.stage == "return_z" then
            if moveZTo(state, state.start.z) then
                return
            end
            state.stage = "return_descend"
            saveState(state)

        elseif state.stage == "return_descend" then
            if moveYTo(state, state.start.y) then
                return
            end
            state.stage = "complete"
            saveState(state)

        elseif state.stage == "complete" then
            drawStatus(state)
            print("")
            print("Round trip complete.")
            print("Returned to initial coordinates.")
            print("")
            print("Press Enter to plan another trip.")
            read()

            if fs.exists(TMP_FILE) then
                fs.delete(TMP_FILE)
            end

            os.reboot()
            return

        else
            pauseTrip(state, "Unknown route stage: " .. tostring(state.stage))
            return
        end
    end
end

local function receiveRemoteUpdate(firstMessage)
    local session = firstMessage.session
    local version = firstMessage.version
    local expected = firstMessage.files

    if type(session) ~= "string" or type(version) ~= "number" or type(expected) ~= "table" then
        return false, "invalid update begin"
    end

    local stage = ".cairn_remote_stage"

    if fs.exists(stage) then
        fs.delete(stage)
    end

    fs.makeDir(stage)

    rednet.send(MAIN_ID, {
        type = "update_ack",
        stage = "begin",
        session = session
    }, UPDATE_PROTOCOL)

    local received = {}

    while true do
        local sender, message, protocol = rednet.receive()

        if sender == MAIN_ID and protocol == UPDATE_PROTOCOL and type(message) == "table" then
            if message.session == session then
                if message.type == "file_begin" then
                    local name = message.name

                    if type(name) ~= "string" then
                        return false, "invalid file name"
                    end

                    local path = fs.combine(stage, name)

                    if fs.exists(path) then
                        fs.delete(path)
                    end

                    local h = fs.open(path, "w")

                    if not h then
                        return false, "could not create staged file"
                    end

                    h.close()
                    received[name] = true

                    rednet.send(MAIN_ID, {
                        type = "update_ack",
                        stage = "file_begin",
                        session = session,
                        name = name
                    }, UPDATE_PROTOCOL)

                elseif message.type == "file_chunk" then
                    local name = message.name
                    local data = message.data

                    if not received[name] or type(data) ~= "string" then
                        return false, "invalid file chunk"
                    end

                    local h = fs.open(fs.combine(stage, name), "a")

                    if not h then
                        return false, "could not append staged file"
                    end

                    h.write(data)
                    h.close()

                    rednet.send(MAIN_ID, {
                        type = "update_ack",
                        stage = "file_chunk",
                        session = session,
                        name = name,
                        index = message.index
                    }, UPDATE_PROTOCOL)

                elseif message.type == "file_end" then
                    local name = message.name
                    local path = fs.combine(stage, name)
                    local fn, err = loadfile(path)

                    if not fn then
                        return false, "validation failed: " .. tostring(err)
                    end

                    rednet.send(MAIN_ID, {
                        type = "update_ack",
                        stage = "file_end",
                        session = session,
                        name = name
                    }, UPDATE_PROTOCOL)

                elseif message.type == "commit" then
                    for _, name in ipairs(expected) do
                        if not received[name] or not fs.exists(fs.combine(stage, name)) then
                            return false, "missing staged file: " .. tostring(name)
                        end
                    end

                    for _, name in ipairs(expected) do
                        local source = fs.combine(stage, name)

                        if fs.exists(name) then
                            fs.delete(name)
                        end

                        fs.move(source, name)
                    end

                    if fs.exists(stage) then
                        fs.delete(stage)
                    end

                    local h = fs.open(".cairn_version", "w")

                    if h then
                        h.write(tostring(version))
                        h.close()
                    end

                    rednet.send(MAIN_ID, {
                        type = "update_ack",
                        stage = "commit",
                        session = session
                    }, UPDATE_PROTOCOL)

                    sleep(0.5)
                    os.reboot()
                    return true
                end
            end
        end
    end
end

local function runFollower()
    clearFollowerOutputs()

    local wiredSide = findWiredModem()

    term.clear()
    term.setCursorPos(1, 1)

    print("CAIRN DRIVE1")
    print("Release v" .. CAIRN_RELEASE)
    print("ID: " .. os.getComputerID())
    print("")

    if not wiredSide then
        print("No wired modem found")
        return
    end

    openModem(wiredSide)

    print("Wired modem: " .. wiredSide)
    print("Waiting for Drive2...")

    while true do
        local sender, message, protocol = rednet.receive()

        if sender == MAIN_ID and type(message) == "table" then
            if protocol == LINK_PROTOCOL then
                if message.type == "ping" then
                    rednet.send(MAIN_ID, {
                        type = "pong",
                        token = message.token,
                        release = CAIRN_RELEASE
                    }, LINK_PROTOCOL)

                elseif message.type == "move" then
                    local move = followerMoves[message.direction]

                    if move then
                        clearFollowerOutputs()

                        rednet.send(MAIN_ID, {
                            type = "move_ack",
                            token = message.token,
                            direction = message.direction
                        }, LINK_PROTOCOL)

                        sleep(0.2)
                        redstone.setOutput(move.side, true)
                        sleep(REBOOT_TIMEOUT)
                        clearFollowerOutputs()
                    else
                        rednet.send(MAIN_ID, {
                            type = "move_reject",
                            token = message.token
                        }, LINK_PROTOCOL)
                    end
                end

            elseif protocol == UPDATE_PROTOCOL and message.type == "update_begin" then
                local success, updateErr = receiveRemoteUpdate(message)

                if not success then
                    pcall(function()
                        rednet.send(MAIN_ID, {
                            type = "update_error",
                            session = message.session,
                            error = tostring(updateErr)
                        }, UPDATE_PROTOCOL)
                    end)

                    if fs.exists(".cairn_remote_stage") then
                        fs.delete(".cairn_remote_stage")
                    end
                end
            end
        end
    end
end

local function runMain()
    clearMainOutputs()

    local wiredSide = findWiredModem()

    if not wiredSide then
        term.clear()
        term.setCursorPos(1, 1)
        print("CAIRN DRIVE2")
        print("")
        print("No wired modem found.")
        return
    end

    openModem(wiredSide)

    if peripheral.getType("top") == "modem" then
        local ok, wireless = pcall(peripheral.call, "top", "isWireless")
        if ok and wireless == true then
            openModem("top")
        end
    end

    local state = loadState()

    if not state then
        state = newTrip()
    end

    if state.armed then
        finishArmedMove(state)
    end

    if state.paused then
        pauseTrip(state, state.error or "Trip paused.")
    end

    advanceTrip(state)
end

local id = os.getComputerID()

if id == MAIN_ID then
    runMain()
elseif id == FOLLOWER_ID then
    runFollower()
else
    term.clear()
    term.setCursorPos(1, 1)
    print("CAIRN DRIVE")
    print("")
    print("Unexpected computer ID: " .. id)
    print("Expected Drive2 = 2700")
    print("Expected Drive1 = 2701")
end
