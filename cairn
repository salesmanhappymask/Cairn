local CAIRN_RELEASE = 12

local CONFIG = {
    leftSide = "left",
    rightSide = "right",
    pulseTime = 0.15,
    rebootTimeout = 3
}

local STATE_FILE = ".cairn_drive_state"
local STATE_VERSION = 2

local moves = {
    back = {
        side = CONFIG.leftSide,
        color = colors.orange,
        colorName = "orange",
        dx = 0,
        dy = 0,
        dz = 1
    },
    right = {
        side = CONFIG.leftSide,
        color = colors.magenta,
        colorName = "magenta",
        dx = 1,
        dy = 0,
        dz = 0
    },
    left = {
        side = CONFIG.leftSide,
        color = colors.lightBlue,
        colorName = "light blue",
        dx = -1,
        dy = 0,
        dz = 0
    },
    down = {
        side = CONFIG.leftSide,
        color = colors.yellow,
        colorName = "yellow",
        dx = 0,
        dy = -1,
        dz = 0
    },
    up = {
        side = CONFIG.rightSide,
        color = colors.lime,
        colorName = "lime",
        dx = 0,
        dy = 1,
        dz = 0
    },
    forward = {
        side = CONFIG.rightSide,
        color = colors.pink,
        colorName = "pink",
        dx = 0,
        dy = 0,
        dz = -1
    }
}

local sequences = {
    [1] = {
        {direction = "up", count = 3},
        {direction = "forward", count = 3},
        {direction = "back", count = 6},
        {direction = "forward", count = 3},
        {direction = "down", count = 3}
    },
    [2] = {
        {direction = "up", count = 5},
        {direction = "forward", count = 10},
        {direction = "left", count = 10},
        {direction = "back", count = 10},
        {direction = "right", count = 10},
        {direction = "down", count = 5}
    }
}

local outMasks = {}

local function maskHas(mask, color)
    return (mask % (color + color)) >= color
end

local function maskAdd(mask, color)
    if maskHas(mask, color) then
        return mask
    end

    return mask + color
end

local function maskRemove(mask, color)
    if maskHas(mask, color) then
        return mask - color
    end

    return mask
end

local function applySide(side)
    redstone.setBundledOutput(side, outMasks[side] or 0)
end

local function sideOn(side, color)
    outMasks[side] = maskAdd(outMasks[side] or 0, color)
    applySide(side)
end

local function sideOff(side, color)
    outMasks[side] = maskRemove(outMasks[side] or 0, color)
    applySide(side)
end

local function allOff()
    outMasks[CONFIG.leftSide] = 0
    outMasks[CONFIG.rightSide] = 0
    applySide(CONFIG.leftSide)
    applySide(CONFIG.rightSide)
end

local function pulse(side, color)
    sideOn(side, color)
    sleep(CONFIG.pulseTime)
    sideOff(side, color)
end

local function defaultState()
    return {
        version = STATE_VERSION,
        x = 0,
        y = 0,
        z = 0,
        active = nil,
        pending = nil,
        step = 1,
        phase = "idle",
        direction = nil
    }
end

local function saveState(state)
    local h = fs.open(STATE_FILE, "w")

    if not h then
        return false
    end

    h.write(textutils.serialize(state))
    h.close()
    return true
end

local function loadState()
    if not fs.exists(STATE_FILE) then
        return defaultState()
    end

    local h = fs.open(STATE_FILE, "r")

    if not h then
        return defaultState()
    end

    local raw = h.readAll()
    h.close()

    local state = textutils.unserialize(raw)

    if type(state) ~= "table" then
        return defaultState()
    end

    if state.version ~= STATE_VERSION then
        return defaultState()
    end

    return state
end

local function atIdle(state)
    return state.x == 0 and state.y == 0 and state.z == 0
end

local function buildSequence(number)
    local result = {}

    for _, segment in ipairs(sequences[number]) do
        for i = 1, segment.count do
            result[#result + 1] = segment.direction
        end
    end

    return result
end

local function finishArmedMove(state)
    if state.phase ~= "armed" or not state.direction then
        return
    end

    local move = moves[state.direction]

    if not move then
        state.phase = "idle"
        state.direction = nil
        saveState(state)
        return
    end

    state.x = state.x + move.dx
    state.y = state.y + move.dy
    state.z = state.z + move.dz

    if state.active == 1 or state.active == 2 then
        state.step = state.step + 1
    end

    state.phase = "idle"
    state.direction = nil
    saveState(state)
end

local function nextReturnMove(state)
    if state.y < 0 then
        return "up"
    end

    if state.x > 0 then
        return "left"
    end

    if state.x < 0 then
        return "right"
    end

    if state.z > 0 then
        return "forward"
    end

    if state.z < 0 then
        return "back"
    end

    if state.y > 0 then
        return "down"
    end

    return nil
end

local function issueMove(state, direction)
    local move = moves[direction]

    if not move then
        return false
    end

    local clearOk, clearErr = pcall(allOff)

    if not clearOk then
        term.clear()
        term.setCursorPos(1, 1)
        print("CAIRN LOCOMOTION")
        print("")
        print("Could not clear RedNet outputs")
        print(tostring(clearErr))
        sleep(2)
        return false
    end

    sleep(0.1)

    state.phase = "armed"
    state.direction = direction

    if not saveState(state) then
        term.clear()
        term.setCursorPos(1, 1)
        print("CAIRN LOCOMOTION")
        print("")
        print("Could not save movement state")
        sleep(2)
        return false
    end

    term.clear()
    term.setCursorPos(1, 1)

    print("CAIRN LOCOMOTION")
    print("Release v" .. CAIRN_RELEASE)
    print("")
    print("Position")
    print("X: " .. state.x .. "  Y: " .. state.y .. "  Z: " .. state.z)
    print("")
    print("Moving: " .. string.upper(direction))
    print("Computer side: " .. move.side)
    print("RedNet color: " .. move.colorName)
    print("")
    print("Pulsing RedNet channel...")

    local ok, err = pcall(
        pulse,
        move.side,
        move.color
    )

    if not ok then
        state.phase = "idle"
        state.direction = nil
        saveState(state)
        pcall(allOff)

        print("")
        print("RedNet pulse failed")
        print(tostring(err))
        sleep(2)
        return false
    end

    print("Pulse complete")
    print("Waiting for carriage reboot...")

    sleep(CONFIG.rebootTimeout)

    pcall(allOff)

    state.phase = "idle"
    state.direction = nil
    saveState(state)

    print("")
    print("No carriage reboot detected")
    print("Movement was not recorded")
    print("")
    print("Press Enter to return to menu")
    read()

    return false
end

local function startSequence(state, number)
    if not atIdle(state) then
        state.pending = number
        state.active = "return"
        state.step = 1
        saveState(state)
        return
    end

    state.active = number
    state.pending = nil
    state.step = 1
    saveState(state)
end

local function handleActive(state)
    if state.active == 1 or state.active == 2 then
        local sequence = buildSequence(state.active)

        if state.step <= #sequence then
            return issueMove(state, sequence[state.step])
        end

        state.active = "return"
        state.step = 1
        saveState(state)
        return true
    end

    if state.active == "return" then
        local direction = nextReturnMove(state)

        if direction then
            return issueMove(state, direction)
        end

        local pending = state.pending

        state.active = nil
        state.pending = nil
        state.step = 1
        saveState(state)

        if pending == 1 or pending == 2 then
            startSequence(state, pending)
            return true
        end

        return true
    end

    return false
end

local function showMenu(state)
    term.clear()
    term.setCursorPos(1, 1)

    print("CAIRN LOCOMOTION TEST")
    print("Release v" .. CAIRN_RELEASE)
    print("")
    print("Relative position")
    print("X: " .. state.x .. "  Y: " .. state.y .. "  Z: " .. state.z)
    print("")

    if atIdle(state) then
        print("Status: IDLE")
    else
        print("Status: OFFSET FROM IDLE")
    end

    print("")
    print("1 - Short movement test")
    print("    Up 3, Forward 3, Back 6,")
    print("    Forward 3, Down 3")
    print("")
    print("2 - Full movement test")
    print("    Up 5, Forward 10, Left 10,")
    print("    Back 10, Right 10, Down 5")
    print("")
    print("Q - Exit")
    print("")
    write("> ")

    return string.lower(read() or "")
end

if not redstone or type(redstone.setBundledOutput) ~= "function" then
    print("CAIRN LOCOMOTION")
    print("")
    print("Bundled redstone API unavailable")
    return
end

local ok, err = pcall(allOff)

if not ok then
    print("CAIRN LOCOMOTION")
    print("")
    print("Could not initialize RedNet outputs")
    print(tostring(err))
    return
end

local state = loadState()

if state.phase == "armed" then
    finishArmedMove(state)
end

while true do
    state = loadState()

    if state.active ~= nil then
        local continuing = handleActive(state)

        if continuing then
            sleep(0.1)
        else
            state = loadState()

            if state.active ~= nil then
                return
            end
        end
    elseif not atIdle(state) then
        state.active = "return"
        state.pending = nil
        state.step = 1
        saveState(state)
    else
        local choice = showMenu(state)

        if choice == "1" then
            startSequence(state, 1)
        elseif choice == "2" then
            startSequence(state, 2)
        elseif choice == "q" then
            allOff()
            term.clear()
            term.setCursorPos(1, 1)
            print("CAIRN locomotion offline")
            return
        end
    end
end
