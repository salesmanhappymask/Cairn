local CAIRN_RELEASE = 20

local MASTER_ID = 2700
local SLAVE_ID = 2701

local LINK_PROTOCOL = "cairn.drive.link"
local COMMAND_PROTOCOL = "cairn.drive.command"
local UPDATE_PROTOCOL = "cairn.drive.update"

local MAIN_STATE_FILE = ".cairn_drive.tmp"
local SLAVE_STATE_FILE = ".cairn_drive1.tmp"

local MAIN_STATE_VERSION = 2
local SLAVE_STATE_VERSION = 1

local MASTER_WIRED_SIDE = "bottom"
local MASTER_WIRELESS_SIDE = "left"
local SLAVE_WIRED_SIDE = "left"
local SLAVE_WIRELESS_SIDE = "bottom"
local SLAVE_DISK_SIDE = "right"

local PULSE_TIME = 0.6
local MOVE_SETTLE_TIME = 0.8
local LINK_TIMEOUT = 1.0
local LINK_ATTEMPTS = 5
local MAX_RECOVERY_REBOOTS = 3

local moves = {
    forward = {
        owner = SLAVE_ID,
        side = "back",
        dx = 0,
        dy = 0,
        dz = -1,
        world = "North"
    },
    back = {
        owner = MASTER_ID,
        side = "back",
        dx = 0,
        dy = 0,
        dz = 1,
        world = "South"
    },
    left = {
        owner = MASTER_ID,
        side = "right",
        dx = 1,
        dy = 0,
        dz = 0,
        world = "East"
    },
    right = {
        owner = MASTER_ID,
        side = "left",
        dx = -1,
        dy = 0,
        dz = 0,
        world = "West"
    },
    up = {
        owner = SLAVE_ID,
        side = "bottom",
        dx = 0,
        dy = 1,
        dz = 0,
        world = "Up"
    },
    down = {
        owner = MASTER_ID,
        side = "top",
        dx = 0,
        dy = -1,
        dz = 0,
        world = "Down"
    }
}

local slaveMoves = {
    forward = moves.forward,
    up = moves.up
}

local function readTable(path)
    if not fs.exists(path) then
        return nil
    end

    local h = fs.open(path, "r")

    if not h then
        return nil
    end

    local raw = h.readAll()
    h.close()

    return textutils.unserialize(raw)
end

local function writeTable(path, value)
    local h = fs.open(path, "w")

    if not h then
        return false
    end

    h.write(textutils.serialize(value))
    h.close()

    return true
end

local function clearMainOutputs()
    redstone.setOutput("back", false)
    redstone.setOutput("left", false)
    redstone.setOutput("right", false)
    redstone.setOutput("top", false)
end

local function clearSlaveOutputs()
    redstone.setOutput("back", false)
    redstone.setOutput("bottom", false)
end

local function modemWireless(side)
    if peripheral.getType(side) ~= "modem" then
        return nil
    end

    local ok, value = pcall(peripheral.call, side, "isWireless")

    if not ok then
        return nil
    end

    return value
end

local function openModem(side)
    if peripheral.getType(side) ~= "modem" then
        return false
    end

    if not rednet.isOpen(side) then
        rednet.open(side)
    end

    return true
end

local function checkMainHardware()
    if peripheral.getType(MASTER_WIRED_SIDE) ~= "modem" then
        return false, "Drive2 requires its wired modem on bottom."
    end

    if modemWireless(MASTER_WIRED_SIDE) ~= false then
        return false, "Drive2 bottom modem must be wired."
    end

    if peripheral.getType(MASTER_WIRELESS_SIDE) ~= "modem" then
        return false, "Drive2 requires its wireless modem on left."
    end

    if modemWireless(MASTER_WIRELESS_SIDE) ~= true then
        return false, "Drive2 left modem must be wireless."
    end

    return true
end

local function checkSlaveHardware()
    if peripheral.getType(SLAVE_WIRED_SIDE) ~= "modem" then
        return false, "Drive1 requires its wired modem on left."
    end

    if modemWireless(SLAVE_WIRED_SIDE) ~= false then
        return false, "Drive1 left modem must be wired."
    end

    if peripheral.getType(SLAVE_WIRELESS_SIDE) ~= "modem" then
        return false, "Drive1 requires its wireless modem on bottom."
    end

    if modemWireless(SLAVE_WIRELESS_SIDE) ~= true then
        return false, "Drive1 bottom modem must be wireless."
    end

    return true
end

local function saveMainState(state)
    return writeTable(MAIN_STATE_FILE, state)
end

local function loadMainState()
    local state = readTable(MAIN_STATE_FILE)

    if type(state) ~= "table" then
        return nil
    end

    if state.version ~= MAIN_STATE_VERSION then
        fs.delete(MAIN_STATE_FILE)
        return nil
    end

    return state
end

local function loadSlaveState()
    local state = readTable(SLAVE_STATE_FILE)

    if type(state) ~= "table" or state.version ~= SLAVE_STATE_VERSION then
        return {
            version = SLAVE_STATE_VERSION,
            boot = 0,
            tx = nil
        }
    end

    return state
end

local function saveSlaveState(state)
    return writeTable(SLAVE_STATE_FILE, state)
end

local function askInteger(label)
    while true do
        write(label .. ": ")
        local raw = read()
        local value = tonumber(raw)

        if value and value == math.floor(value) then
            return value
        end

        print("Please enter a whole-number coordinate.")
    end
end

local function drawHardwareError(role, message)
    term.clear()
    term.setCursorPos(1, 1)
    print("CAIRN " .. role)
    print("Release v" .. CAIRN_RELEASE)
    print("")
    print("Hardware configuration error")
    print(message)
end

local function drawRoute(state, action)
    term.clear()
    term.setCursorPos(1, 1)

    print("CAIRN NAVIGATION")
    print("Release v" .. CAIRN_RELEASE)
    print("")
    print("Current")
    print(
        "X " ..
        state.current.x ..
        "   Y " ..
        state.current.y ..
        "   Z " ..
        state.current.z
    )
    print("")
    print("Destination")
    print(
        "X " ..
        state.destination.x ..
        "   Y " ..
        state.destination.y ..
        "   Z " ..
        state.destination.z
    )
    print("")
    print("Cruise Y: " .. state.cruise)
    print("Stage: " .. state.stage)

    if action then
        local move = moves[action]
        print("")
        print("Move: " .. string.upper(action) .. " / " .. move.world)

        if move.owner == MASTER_ID then
            print("Controller: Drive2 " .. move.side)
        else
            print("Controller: Drive1 " .. move.side)
        end
    end
end

local function waitLinkType(expected, token, timeout)
    local deadline = os.clock() + timeout

    while os.clock() < deadline do
        local remaining = deadline - os.clock()
        local sender, message = rednet.receive(LINK_PROTOCOL, remaining)

        if not sender then
            return nil
        end

        if sender == SLAVE_ID and type(message) == "table" then
            if message.type == expected then
                if token == nil or message.token == token then
                    return message
                end
            end
        end
    end

    return nil
end

local function pingSlaveOnce()
    local token =
        "ping:" ..
        tostring(os.getComputerID()) ..
        ":" ..
        tostring(math.floor(os.clock() * 1000))

    rednet.send(SLAVE_ID, {
        type = "ping",
        token = token
    }, LINK_PROTOCOL)

    return waitLinkType("pong", token, LINK_TIMEOUT)
end

local function pingSlave()
    for attempt = 1, LINK_ATTEMPTS do
        local reply = pingSlaveOnce()

        if reply then
            return reply
        end

        sleep(0.25)
    end

    return nil
end

local function prepareSlave(tx)
    for attempt = 1, LINK_ATTEMPTS do
        rednet.send(SLAVE_ID, {
            type = "prepare",
            token = tx.token,
            direction = tx.direction,
            executor = tx.owner
        }, LINK_PROTOCOL)

        local reply = waitLinkType("prepared", tx.token, LINK_TIMEOUT)

        if reply then
            return true
        end

        sleep(0.25)
    end

    return false
end

local function querySlaveTx(token)
    rednet.send(SLAVE_ID, {
        type = "tx_status",
        token = token
    }, LINK_PROTOCOL)

    return waitLinkType("tx_status", token, LINK_TIMEOUT)
end

local function commitSlave(token)
    rednet.send(SLAVE_ID, {
        type = "commit",
        token = token
    }, LINK_PROTOCOL)

    waitLinkType("commit_ack", token, 0.75)
end

local function pulseMain(side)
    clearMainOutputs()
    redstone.setOutput(side, true)
    sleep(PULSE_TIME)
    redstone.setOutput(side, false)
    sleep(MOVE_SETTLE_TIME)
end

local function commitMove(state)
    local tx = state.tx

    if not tx then
        return false
    end

    local move = moves[tx.direction]

    if not move then
        return false
    end

    state.current.x = state.current.x + move.dx
    state.current.y = state.current.y + move.dy
    state.current.z = state.current.z + move.dz

    local token = tx.token

    state.tx = nil

    saveMainState(state)
    commitSlave(token)

    term.clear()
    term.setCursorPos(1, 1)
    print("CAIRN NAVIGATION")
    print("")
    print("Move confirmed by drive link.")
    print(
        "X " ..
        state.current.x ..
        "   Y " ..
        state.current.y ..
        "   Z " ..
        state.current.z
    )
    print("")
    print("Restarting navigator...")

    sleep(0.5)
    os.reboot()

    return true
end

local function recoveryFailure(state, message)
    local tx = state.tx

    if not tx then
        return
    end

    tx.recoveryReboots = (tx.recoveryReboots or 0) + 1
    saveMainState(state)

    term.clear()
    term.setCursorPos(1, 1)
    print("CAIRN MOVEMENT RECOVERY")
    print("")
    print(message)
    print("")
    print(
        "Automatic recovery reboot " ..
        tx.recoveryReboots ..
        "/" ..
        MAX_RECOVERY_REBOOTS
    )

    if tx.recoveryReboots <= MAX_RECOVERY_REBOOTS then
        sleep(1.5)
        os.reboot()
        return
    end

    print("")
    print("Automatic recovery limit reached.")
    print("Press Enter to retry recovery.")
    print("Type CANCEL to discard the trip.")

    local answer = string.lower(read() or "")

    if answer == "cancel" then
        if fs.exists(MAIN_STATE_FILE) then
            fs.delete(MAIN_STATE_FILE)
        end
        os.reboot()
        return
    end

    tx.recoveryReboots = 0
    saveMainState(state)
    os.reboot()
end

local function confirmLocalMove(state)
    local tx = state.tx

    for attempt = 1, LINK_ATTEMPTS do
        local reply = querySlaveTx(tx.token)

        if reply and reply.present == true then
            return commitMove(state)
        end

        sleep(0.35)
    end

    recoveryFailure(
        state,
        "Drive1 slave did not check in after Drive2 movement."
    )

    return false
end

local function sendSlaveExecute(tx)
    rednet.send(SLAVE_ID, {
        type = "execute",
        token = tx.token,
        direction = tx.direction
    }, LINK_PROTOCOL)
end

local function confirmSlaveMove(state)
    local tx = state.tx

    for attempt = 1, LINK_ATTEMPTS do
        local reply = querySlaveTx(tx.token)

        if reply and reply.present == true then
            if reply.phase == "complete" then
                return commitMove(state)
            end

            if reply.phase == "prepared" then
                sendSlaveExecute(tx)
            end
        else
            if pingSlaveOnce() then
                if prepareSlave(tx) then
                    sendSlaveExecute(tx)
                end
            end
        end

        sleep(0.45)
    end

    recoveryFailure(
        state,
        "Drive1 slave did not confirm its movement transaction."
    )

    return false
end

local function runTransaction(state)
    local tx = state.tx

    if not tx then
        return false
    end

    local move = moves[tx.direction]

    if not move then
        recoveryFailure(state, "Unknown movement transaction.")
        return false
    end

    drawRoute(state, tx.direction)

    if tx.phase == "created" then
        if not pingSlave() then
            recoveryFailure(
                state,
                "Drive1 slave is not responding on the wired network."
            )
            return false
        end

        if not prepareSlave(tx) then
            recoveryFailure(
                state,
                "Drive1 slave did not prepare the movement transaction."
            )
            return false
        end

        tx.phase = "prepared"
        saveMainState(state)
    end

    if move.owner == MASTER_ID then
        if tx.phase == "prepared" then
            tx.phase = "local_issued"
            saveMainState(state)

            pulseMain(move.side)

            tx.phase = "await_peer"
            saveMainState(state)
        end

        if tx.phase == "local_issued" or tx.phase == "await_peer" then
            return confirmLocalMove(state)
        end

    else
        if tx.phase == "prepared" then
            tx.phase = "remote_issued"
            saveMainState(state)
            sendSlaveExecute(tx)
        end

        if tx.phase == "remote_issued" then
            return confirmSlaveMove(state)
        end
    end

    recoveryFailure(state, "Invalid transaction phase: " .. tostring(tx.phase))
    return false
end

local function newMove(state, direction)
    local move = moves[direction]

    if not move then
        recoveryFailure(state, "Invalid direction: " .. tostring(direction))
        return
    end

    state.sequence = (state.sequence or 0) + 1

    state.tx = {
        token =
            tostring(MASTER_ID) ..
            ":" ..
            tostring(state.sequence) ..
            ":" ..
            direction,
        direction = direction,
        owner = move.owner,
        phase = "created",
        recoveryReboots = 0
    }

    saveMainState(state)
    runTransaction(state)
end

local function moveYTo(state, target)
    if state.current.y < target then
        newMove(state, "up")
        return true
    end

    if state.current.y > target then
        newMove(state, "down")
        return true
    end

    return false
end

local function moveXTo(state, target)
    if state.current.x < target then
        newMove(state, "left")
        return true
    end

    if state.current.x > target then
        newMove(state, "right")
        return true
    end

    return false
end

local function moveZTo(state, target)
    if state.current.z > target then
        newMove(state, "forward")
        return true
    end

    if state.current.z < target then
        newMove(state, "back")
        return true
    end

    return false
end

local function waitForSlaveInteractive()
    while true do
        term.clear()
        term.setCursorPos(1, 1)
        print("CAIRN DRIVE PREFLIGHT")
        print("Release v" .. CAIRN_RELEASE)
        print("")
        print("Checking Drive1 / 2701...")

        local reply = pingSlave()

        if reply then
            print("Drive1 slave online")
            print("Drive1 slave release: v" .. tostring(reply.release))
            sleep(0.75)
            return
        end

        print("")
        print("Drive1 did not answer.")
        print("Press Enter to retry.")
        read()
    end
end

local function newTrip()
    waitForSlaveInteractive()

    term.clear()
    term.setCursorPos(1, 1)

    print("CAIRN NAVIGATION")
    print("Release v" .. CAIRN_RELEASE)
    print("")
    print("Forward = North = -Z")
    print("Backward = South = +Z")
    print("Left = East = +X")
    print("Right = West = -X")
    print("")
    print("Enter current coordinates")

    local sx = askInteger("X")
    local sy = askInteger("Y")
    local sz = askInteger("Z")

    print("")
    print("Enter destination coordinates")

    local dx = askInteger("X")
    local dy = askInteger("Y")
    local dz = askInteger("Z")

    print("")

    local cruise

    while true do
        cruise = askInteger("Cruise altitude Y")

        if cruise >= sy and cruise >= dy then
            break
        end

        print(
            "Cruise altitude must be at or above current and destination Y."
        )
    end

    local state = {
        version = MAIN_STATE_VERSION,
        start = {
            x = sx,
            y = sy,
            z = sz
        },
        destination = {
            x = dx,
            y = dy,
            z = dz
        },
        cruise = cruise,
        current = {
            x = sx,
            y = sy,
            z = sz
        },
        stage = "out_climb",
        sequence = 0,
        tx = nil
    }

    saveMainState(state)

    return state
end

local function advanceTrip(state)
    while true do
        if state.tx then
            runTransaction(state)
            return
        end

        if state.stage == "out_climb" then
            if moveYTo(state, state.cruise) then
                return
            end

            state.stage = "out_x"
            saveMainState(state)

        elseif state.stage == "out_x" then
            if moveXTo(state, state.destination.x) then
                return
            end

            state.stage = "out_z"
            saveMainState(state)

        elseif state.stage == "out_z" then
            if moveZTo(state, state.destination.z) then
                return
            end

            state.stage = "out_descend"
            saveMainState(state)

        elseif state.stage == "out_descend" then
            if moveYTo(state, state.destination.y) then
                return
            end

            state.stage = "dwell"
            saveMainState(state)

        elseif state.stage == "dwell" then
            drawRoute(state)
            print("")
            print("Destination reached.")
            print("Waiting 10 seconds before return...")
            sleep(10)

            state.stage = "return_climb"
            saveMainState(state)

        elseif state.stage == "return_climb" then
            if moveYTo(state, state.cruise) then
                return
            end

            state.stage = "return_x"
            saveMainState(state)

        elseif state.stage == "return_x" then
            if moveXTo(state, state.start.x) then
                return
            end

            state.stage = "return_z"
            saveMainState(state)

        elseif state.stage == "return_z" then
            if moveZTo(state, state.start.z) then
                return
            end

            state.stage = "return_descend"
            saveMainState(state)

        elseif state.stage == "return_descend" then
            if moveYTo(state, state.start.y) then
                return
            end

            state.stage = "complete"
            saveMainState(state)

        elseif state.stage == "complete" then
            drawRoute(state)
            print("")
            print("Round trip complete.")
            print("Returned to initial coordinates.")
            print("")
            print("Press Enter to plan another trip.")
            read()

            if fs.exists(MAIN_STATE_FILE) then
                fs.delete(MAIN_STATE_FILE)
            end

            os.reboot()
            return

        else
            term.clear()
            term.setCursorPos(1, 1)
            print("CAIRN NAVIGATION")
            print("")
            print("Unknown route stage: " .. tostring(state.stage))
            print("Delete " .. MAIN_STATE_FILE .. " to reset.")
            return
        end
    end
end

local function receiveRemoteUpdate(firstMessage)
    local session = firstMessage.session
    local version = firstMessage.version
    local expected = firstMessage.files

    if
        type(session) ~= "string" or
        type(version) ~= "number" or
        type(expected) ~= "table"
    then
        return false, "invalid update begin"
    end

    local stage = ".cairn_remote_stage"

    if fs.exists(stage) then
        fs.delete(stage)
    end

    fs.makeDir(stage)

    rednet.send(MASTER_ID, {
        type = "update_ack",
        stage = "begin",
        session = session
    }, UPDATE_PROTOCOL)

    local received = {}

    while true do
        local sender, message, protocol = rednet.receive()

        if
            sender == MASTER_ID and
            protocol == UPDATE_PROTOCOL and
            type(message) == "table" and
            message.session == session
        then
            if message.type == "file_begin" then
                local name = message.name

                if type(name) ~= "string" then
                    return false, "invalid file name"
                end

                local path = fs.combine(stage, name)

                if fs.exists(path) then
                    fs.delete(path)
                end

                local h = fs.open(path, "w")

                if not h then
                    return false, "could not create staged file"
                end

                h.close()
                received[name] = true

                rednet.send(MASTER_ID, {
                    type = "update_ack",
                    stage = "file_begin",
                    session = session,
                    name = name
                }, UPDATE_PROTOCOL)

            elseif message.type == "file_chunk" then
                local name = message.name
                local data = message.data

                if not received[name] or type(data) ~= "string" then
                    return false, "invalid file chunk"
                end

                local h = fs.open(fs.combine(stage, name), "a")

                if not h then
                    return false, "could not append staged file"
                end

                h.write(data)
                h.close()

                rednet.send(MASTER_ID, {
                    type = "update_ack",
                    stage = "file_chunk",
                    session = session,
                    name = name,
                    index = message.index
                }, UPDATE_PROTOCOL)

            elseif message.type == "file_end" then
                local name = message.name
                local path = fs.combine(stage, name)
                local fn, err = loadfile(path)

                if not fn then
                    return false, "validation failed: " .. tostring(err)
                end

                rednet.send(MASTER_ID, {
                    type = "update_ack",
                    stage = "file_end",
                    session = session,
                    name = name
                }, UPDATE_PROTOCOL)

            elseif message.type == "commit" then
                for _, name in ipairs(expected) do
                    if
                        not received[name] or
                        not fs.exists(fs.combine(stage, name))
                    then
                        return false, "missing staged file: " .. tostring(name)
                    end
                end

                for _, name in ipairs(expected) do
                    local source = fs.combine(stage, name)

                    if fs.exists(name) then
                        fs.delete(name)
                    end

                    fs.move(source, name)
                end

                if fs.exists(stage) then
                    fs.delete(stage)
                end

                local h = fs.open(".cairn_version", "w")

                if h then
                    h.write(tostring(version))
                    h.close()
                end

                rednet.send(MASTER_ID, {
                    type = "update_ack",
                    stage = "commit",
                    session = session
                }, UPDATE_PROTOCOL)

                sleep(0.5)
                os.reboot()

                return true
            end
        end
    end
end

local function slaveReply(state, messageType, token, extra)
    local payload = extra or {}

    payload.type = messageType
    payload.token = token
    payload.release = CAIRN_RELEASE
    payload.boot = state.boot

    rednet.send(MASTER_ID, payload, LINK_PROTOCOL)
end

local function slaveStatus(state, token)
    local present =
        state.tx ~= nil and
        state.tx.token == token

    slaveReply(
        state,
        "tx_status",
        token,
        {
            present = present,
            phase = present and state.tx.phase or nil,
            direction = present and state.tx.direction or nil,
            executor = present and state.tx.executor or nil
        }
    )
end

local function runSlave()
    clearSlaveOutputs()

    local hardwareOk, hardwareError = checkSlaveHardware()

    if not hardwareOk then
        drawHardwareError("DRIVE1 SLAVE", hardwareError)
        return
    end

    openModem(SLAVE_WIRED_SIDE)
    openModem(SLAVE_WIRELESS_SIDE)

    local state = loadSlaveState()

    state.boot = (state.boot or 0) + 1

    if
        state.tx and
        state.tx.executor == SLAVE_ID and
        state.tx.phase == "executing"
    then
        state.tx.phase = "complete"
        state.tx.recovered = true
    end

    saveSlaveState(state)

    term.clear()
    term.setCursorPos(1, 1)
    print("CAIRN DRIVE1 SLAVE")
    print("Release v" .. CAIRN_RELEASE)
    print("ID: " .. os.getComputerID())
    print("")
    print("Facing: South")
    print("Wired modem: left")
    print("Wireless modem: bottom")
    print("Disk drive: right")
    print("")
    print("Back output: Forward / North")
    print("Bottom output: Up")
    print("")
    print("Waiting for Drive2 master...")

    while true do
        local sender, message, protocol = rednet.receive()

        if
            sender == MASTER_ID and
            protocol == LINK_PROTOCOL and
            type(message) == "table"
        then
            if message.type == "ping" then
                slaveReply(
                    state,
                    "pong",
                    message.token,
                    {
                        lastToken = state.tx and state.tx.token or nil,
                        lastPhase = state.tx and state.tx.phase or nil
                    }
                )

            elseif message.type == "prepare" then
                if
                    not state.tx or
                    state.tx.token ~= message.token
                then
                    state.tx = {
                        token = message.token,
                        direction = message.direction,
                        executor = message.executor,
                        phase = "prepared",
                        preparedBoot = state.boot
                    }

                    saveSlaveState(state)
                end

                slaveReply(
                    state,
                    "prepared",
                    message.token,
                    {
                        phase = state.tx.phase
                    }
                )

            elseif message.type == "tx_status" then
                slaveStatus(state, message.token)

            elseif message.type == "execute" then
                if
                    state.tx and
                    state.tx.token == message.token and
                    state.tx.executor == SLAVE_ID and
                    slaveMoves[message.direction]
                then
                    if state.tx.phase == "complete" then
                        slaveReply(
                            state,
                            "move_complete",
                            message.token,
                            {
                                direction = message.direction
                            }
                        )

                    elseif state.tx.phase == "prepared" then
                        local move = slaveMoves[message.direction]

                        state.tx.phase = "executing"
                        saveSlaveState(state)

                        slaveReply(
                            state,
                            "execute_ack",
                            message.token,
                            {
                                direction = message.direction
                            }
                        )

                        sleep(0.15)
                        clearSlaveOutputs()
                        redstone.setOutput(move.side, true)
                        sleep(PULSE_TIME)
                        redstone.setOutput(move.side, false)
                        sleep(MOVE_SETTLE_TIME)

                        state.tx.phase = "complete"
                        saveSlaveState(state)

                        slaveReply(
                            state,
                            "move_complete",
                            message.token,
                            {
                                direction = message.direction
                            }
                        )

                    elseif state.tx.phase == "executing" then
                        slaveReply(
                            state,
                            "execute_ack",
                            message.token,
                            {
                                direction = message.direction
                            }
                        )
                    end
                end

            elseif message.type == "commit" then
                if state.tx and state.tx.token == message.token then
                    state.tx = nil
                    saveSlaveState(state)
                end

                slaveReply(
                    state,
                    "commit_ack",
                    message.token
                )
            end

        elseif
            sender == MASTER_ID and
            protocol == UPDATE_PROTOCOL and
            type(message) == "table" and
            message.type == "update_begin"
        then
            local success, updateError = receiveRemoteUpdate(message)

            if not success then
                pcall(function()
                    rednet.send(MASTER_ID, {
                        type = "update_error",
                        session = message.session,
                        error = tostring(updateError)
                    }, UPDATE_PROTOCOL)
                end)

                if fs.exists(".cairn_remote_stage") then
                    fs.delete(".cairn_remote_stage")
                end
            end

        elseif
            sender ~= MASTER_ID and
            protocol == COMMAND_PROTOCOL
        then
            rednet.send(MASTER_ID, {
                type = "wireless_forward",
                sender = sender,
                message = message
            }, LINK_PROTOCOL)
        end
    end
end

local function runMain()
    clearMainOutputs()

    local hardwareOk, hardwareError = checkMainHardware()

    if not hardwareOk then
        drawHardwareError("DRIVE2 MASTER", hardwareError)
        return
    end

    openModem(MASTER_WIRED_SIDE)
    openModem(MASTER_WIRELESS_SIDE)

    local state = loadMainState()

    if not state then
        state = newTrip()
    end

    advanceTrip(state)
end

local id = os.getComputerID()

if id == MASTER_ID then
    runMain()
elseif id == SLAVE_ID then
    runSlave()
else
    term.clear()
    term.setCursorPos(1, 1)
    print("CAIRN DRIVE")
    print("")
    print("Unexpected computer ID: " .. id)
    print("Expected Drive2 = 2700")
    print("Expected Drive1 = 2701")
end
