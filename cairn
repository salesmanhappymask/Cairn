    print("")
    print("Current")
    print(
        "X " ..
        state.current.x ..
        "   Y " ..
        state.current.y ..
        "   Z " ..
        state.current.z
    )
    print("")
    print("Destination")
    print(
        "X " ..
        state.destination.x ..
        "   Y " ..
        state.destination.y ..
        "   Z " ..
        state.destination.z
    )
