local CAIRN_RELEASE = 20

local id = os.getComputerID()

if redstone and redstone.setOutput then
    if id == 2700 then
        pcall(redstone.setOutput, "back", false)
        pcall(redstone.setOutput, "left", false)
        pcall(redstone.setOutput, "right", false)
        pcall(redstone.setOutput, "top", false)
    elseif id == 2701 then
        pcall(redstone.setOutput, "back", false)
        pcall(redstone.setOutput, "bottom", false)
    end
end

sleep(0.5)
shell.run("cairn")
