local CAIRN_RELEASE = 4
local args = {...}

local STATE_FILE = ".cairn_locomotion_test"
local STATE_VERSION = 1
local DISCOVERY_ATTEMPTS = 40
local DISCOVERY_DELAY = 0.25

local sides = {
    "left",
    "right",
    "top",
    "bottom",
    "front",
    "back"
}

local directions = {
    north = {
        forward = 2,
        backward = 3,
        left = 4,
        right = 5
    },
    south = {
        forward = 3,
        backward = 2,
        left = 5,
        right = 4
    },
    west = {
        forward = 4,
        backward = 5,
        left = 3,
        right = 2
    },
    east = {
        forward = 5,
        backward = 4,
        left = 2,
        right = 3
    }
}

local function saveState(state)
    local h = fs.open(STATE_FILE, "w")

    if not h then
        return false, "Could not open state file"
    end

    h.write(textutils.serialize(state))
    h.close()

    return true
end

local function loadState()
    if not fs.exists(STATE_FILE) then
        return nil
    end

    local h = fs.open(STATE_FILE, "r")

    if not h then
        error("Could not read saved locomotion state")
    end

    local raw = h.readAll()
    h.close()

    local state = textutils.unserialize(raw)

    if type(state) ~= "table" then
        error("Saved locomotion state is invalid")
    end

    return state
end

local function typeOf(name)
    local ok, value = pcall(peripheral.getType, name)

    if not ok or value == nil then
        return nil
    end

    return tostring(value)
end

local function isController(name)
    local typeName = typeOf(name)

    if not typeName then
        return false, nil
    end

    local lowered = string.lower(typeName)

    if string.find(lowered, "carriagecontroller", 1, true) then
        return true, typeName
    end

    if string.find(lowered, "carriage_controller", 1, true) then
        return true, typeName
    end

    return false, typeName
end

local function scanController()
    for _, side in ipairs(sides) do
        if peripheral.isPresent(side) then
            local match, typeName = isController(side)

            if match then
                return side, typeName
            end
        end
    end

    if peripheral.getNames then
        local ok, names = pcall(peripheral.getNames)

        if ok and type(names) == "table" then
            for _, name in ipairs(names) do
                local match, typeName = isController(name)

                if match then
                    return name, typeName
                end
            end
        end
    end

    return nil
end

local function findController()
    for attempt = 1, DISCOVERY_ATTEMPTS do
        local name, typeName = scanController()

        if name then
            return name, typeName
        end

        if attempt < DISCOVERY_ATTEMPTS then
            sleep(DISCOVERY_DELAY)
        end
    end

    return nil
end

local function printPeripherals()
    print("Visible peripherals:")

    local seen = {}
    local count = 0

    local function show(name)
        if seen[name] then
            return
        end

        seen[name] = true
        count = count + 1
        print("  " .. tostring(name) .. " [" .. tostring(typeOf(name)) .. "]")
    end

    for _, side in ipairs(sides) do
        if peripheral.isPresent(side) then
            show(side)
        end
    end

    if peripheral.getNames then
        local ok, names = pcall(peripheral.getNames)

        if ok and type(names) == "table" then
            for _, name in ipairs(names) do
                show(name)
            end
        end
    end

    if count == 0 then
        print("  none")
    end
end

local function moveController(name, direction, simulate)
    local ok, result, message, x, y, z = pcall(
        peripheral.call,
        name,
        "move",
        direction,
        simulate,
        false
    )

    if not ok then
        return false, tostring(result)
    end

    if result == false then
        local text = tostring(message or "Move rejected")

        if x ~= nil and y ~= nil and z ~= nil then
            text = text .. " at " .. tostring(x) .. "," .. tostring(y) .. "," .. tostring(z)
        end

        return false, text
    end

    return true
end

local function buildMoves(forward)
    local d = directions[forward]

    local plan = {
        {"Raise", 1, 5},
        {"Forward", d.forward, 5},
        {"Backward", d.backward, 10},
        {"Forward", d.forward, 5},
        {"Left", d.left, 5},
        {"Right", d.right, 10},
        {"Left", d.left, 5},
        {"Lower", 0, 5}
    }

    local moves = {}

    for _, segment in ipairs(plan) do
        for step = 1, segment[3] do
            moves[#moves + 1] = {
                label = segment[1] .. " " .. step .. "/" .. segment[3],
                direction = segment[2]
            }
        end
    end

    return moves
end

local function chooseForward()
    if args[1] and args[1] ~= "--resume" then
        local supplied = string.lower(args[1])

        if directions[supplied] then
            return supplied
        end
    end

    print("Which world direction is the FRONT of Cairn facing?")
    write("north/south/east/west: ")

    local answer = read()

    if answer then
        answer = string.lower(answer)

        if directions[answer] then
            return answer
        end
    end

    return nil
end

local function run()
    print("CAIRN locomotion test")
    print("Release: v" .. CAIRN_RELEASE)
    print("")

    if args[1] == "reset" then
        if fs.exists(STATE_FILE) then
            fs.delete(STATE_FILE)
        end

        print("Locomotion test state cleared")
        return
    end

    local state = loadState()

    if not state then
        local forward = chooseForward()

        if not forward then
            print("Invalid forward direction")
            return
        end

        state = {
            stateVersion = STATE_VERSION,
            forward = forward,
            index = 1
        }

        local saved, saveErr = saveState(state)

        if not saved then
            error(saveErr or "Could not save initial state")
        end

        print("")
        print("Test initialized")
        print("Forward: " .. forward)
        print("Moves: 50")
        print("")
    else
        print("Resuming saved test")
        print("Forward: " .. tostring(state.forward))
        print("Next step: " .. tostring(state.index))
        print("")
    end

    if state.stateVersion ~= STATE_VERSION then
        print("Saved locomotion state is from an incompatible version")
        print("Run: locomotion_test reset")
        return
    end

    if not directions[state.forward] then
        error("Saved forward direction is invalid")
    end

    local moves = buildMoves(state.forward)

    if state.index > #moves then
        if fs.exists(STATE_FILE) then
            fs.delete(STATE_FILE)
        end

        print("Test complete")
        return
    end

    print("Searching for carriage controller...")

    local controller, typeName = findController()

    if not controller then
        print("No carriage controller found")
        printPeripherals()
        print("Run cairn_probe for full peripheral diagnostics")
        return
    end

    print("Controller: " .. tostring(controller))
    print("Type: " .. tostring(typeName))

    local move = moves[state.index]

    print("Step " .. state.index .. "/" .. #moves .. ": " .. move.label)
    print("Simulating...")

    local possible, simErr = moveController(
        controller,
        move.direction,
        true
    )

    if not possible then
        print("Simulation failed")
        print(tostring(simErr))
        return
    end

    print("Simulation passed")

    local previousIndex = state.index
    state.index = state.index + 1

    local saved, saveErr = saveState(state)

    if not saved then
        state.index = previousIndex
        error(saveErr or "Could not save movement progress")
    end

    print("Moving...")

    local moved, moveErr = moveController(
        controller,
        move.direction,
        false
    )

    if not moved then
        state.index = previousIndex
        saveState(state)

        print("Move failed")
        print(tostring(moveErr))
        print("Progress restored to step " .. previousIndex)
        return
    end

    sleep(1.5)
    os.reboot()
end

local ok, err = pcall(run)

if not ok then
    print("")
    print("CAIRN locomotion error")
    print(tostring(err))
end
