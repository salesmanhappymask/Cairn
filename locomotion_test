local CAIRN_RELEASE = 5
local args = {...}

local STATE_FILE = ".cairn_locomotion_test"
local STATE_VERSION = 1

local sides = {
    "left",
    "right",
    "top",
    "bottom",
    "front",
    "back"
}

local relative = {
    north = {
        forward = "north",
        backward = "south",
        left = "west",
        right = "east"
    },
    south = {
        forward = "south",
        backward = "north",
        left = "east",
        right = "west"
    },
    west = {
        forward = "west",
        backward = "east",
        left = "south",
        right = "north"
    },
    east = {
        forward = "east",
        backward = "west",
        left = "north",
        right = "south"
    }
}

local function saveState(state)
    local h = fs.open(STATE_FILE, "w")

    if not h then
        return false
    end

    h.write(textutils.serialize(state))
    h.close()
    return true
end

local function loadState()
    if not fs.exists(STATE_FILE) then
        return nil
    end

    local h = fs.open(STATE_FILE, "r")

    if not h then
        return nil
    end

    local raw = h.readAll()
    h.close()

    return textutils.unserialize(raw)
end

local function looksLikeController(name)
    local ok, typeName = pcall(peripheral.getType, name)

    if not ok or typeName == nil then
        return false
    end

    local text = string.lower(tostring(name) .. " " .. tostring(typeName))

    if string.find(text, "carriagecontroller", 1, true) then
        return true
    end

    if string.find(text, "carriage_controller", 1, true) then
        return true
    end

    return false
end

local function findController()
    for _, side in ipairs(sides) do
        if peripheral.isPresent(side) and looksLikeController(side) then
            return side
        end
    end

    if peripheral.getNames then
        local ok, names = pcall(peripheral.getNames)

        if ok and type(names) == "table" then
            for _, name in ipairs(names) do
                if looksLikeController(name) then
                    return name
                end
            end
        end
    end

    return nil
end

local function printVisible()
    print("Visible peripherals:")

    local found = false
    local seen = {}

    local function show(name)
        if seen[name] then
            return
        end

        seen[name] = true
        found = true

        local ok, typeName = pcall(peripheral.getType, name)

        if ok then
            print("  " .. tostring(name) .. " [" .. tostring(typeName) .. "]")
        else
            print("  " .. tostring(name) .. " [type lookup failed]")
        end
    end

    for _, side in ipairs(sides) do
        if peripheral.isPresent(side) then
            show(side)
        end
    end

    if peripheral.getNames then
        local ok, names = pcall(peripheral.getNames)

        if ok and type(names) == "table" then
            for _, name in ipairs(names) do
                show(name)
            end
        end
    end

    if not found then
        print("  none")
    end
end

local function callRim(controller, method, direction)
    local ok, success, message, x, y, z = pcall(
        peripheral.call,
        controller,
        method,
        direction
    )

    if not ok then
        return false, tostring(success)
    end

    if success == false then
        local text = tostring(message or "RIM rejected movement")

        if x ~= nil and y ~= nil and z ~= nil then
            text = text .. " at " .. tostring(x) .. "," .. tostring(y) .. "," .. tostring(z)
        end

        return false, text
    end

    return true
end

local function buildMoves(facing)
    local d = relative[facing]

    local plan = {
        {"Raise", "up", 5},
        {"Forward", d.forward, 5},
        {"Backward", d.backward, 10},
        {"Forward", d.forward, 5},
        {"Left", d.left, 5},
        {"Right", d.right, 10},
        {"Left", d.left, 5},
        {"Lower", "down", 5}
    }

    local moves = {}

    for _, segment in ipairs(plan) do
        for i = 1, segment[3] do
            moves[#moves + 1] = {
                label = segment[1] .. " " .. i .. "/" .. segment[3],
                direction = segment[2]
            }
        end
    end

    return moves
end

local function getFacing()
    if args[1] and args[1] ~= "--resume" then
        local value = string.lower(args[1])

        if relative[value] then
            return value
        end
    end

    print("Which world direction is Cairn facing?")
    write("north/south/east/west: ")

    local value = read()

    if value then
        value = string.lower(value)

        if relative[value] then
            return value
        end
    end

    return nil
end

local function main()
    print("CAIRN locomotion test")
    print("Release: v" .. CAIRN_RELEASE)
    print("RIM API: native 2.3.0.0 commands")
    print("")

    if args[1] == "reset" then
        if fs.exists(STATE_FILE) then
            fs.delete(STATE_FILE)
        end

        print("Test state cleared")
        return
    end

    local state = loadState()

    if not state then
        local facing = getFacing()

        if not facing then
            print("Invalid facing")
            return
        end

        state = {
            version = STATE_VERSION,
            facing = facing,
            step = 1
        }

        if not saveState(state) then
            print("Could not save test state")
            return
        end

        print("")
        print("Test initialized")
        print("Facing: " .. facing)
        print("")
    else
        print("Resuming test")
        print("Facing: " .. tostring(state.facing))
        print("Next step: " .. tostring(state.step))
        print("")
    end

    if state.version ~= STATE_VERSION or not relative[state.facing] then
        print("Saved state is invalid")
        print("Run: locomotion_test reset")
        return
    end

    local moves = buildMoves(state.facing)

    if state.step > #moves then
        if fs.exists(STATE_FILE) then
            fs.delete(STATE_FILE)
        end

        print("Test complete")
        return
    end

    print("Searching for RIM carriage controller...")

    local controller = findController()

    if not controller then
        print("Controller not found")
        printVisible()
        print("Run cairn_probe for method details")
        return
    end

    local okType, typeName = pcall(peripheral.getType, controller)

    print("Controller: " .. tostring(controller))
    print("Type: " .. tostring(okType and typeName or "unknown"))

    local move = moves[state.step]

    print("Step " .. state.step .. "/" .. #moves)
    print(move.label .. " -> " .. move.direction)
    print("Checking unanchored move...")

    local valid, checkErr = callRim(
        controller,
        "check_unanchored_move",
        move.direction
    )

    if not valid then
        print("Movement check failed")
        print(tostring(checkErr))
        return
    end

    print("Movement check passed")

    local oldStep = state.step
    state.step = state.step + 1

    if not saveState(state) then
        print("Could not save next step")
        return
    end

    print("Executing unanchored move...")

    local moved, moveErr = callRim(
        controller,
        "unanchored_move",
        move.direction
    )

    if not moved then
        state.step = oldStep
        saveState(state)

        print("Movement failed")
        print(tostring(moveErr))
        print("Progress restored to step " .. oldStep)
        return
    end

    print("Move returned without reboot")
    sleep(1)
    os.reboot()
end

local ok, err = pcall(main)

if not ok then
    print("")
    print("CAIRN locomotion error:")
    print(tostring(err))
end
