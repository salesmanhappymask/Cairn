local args = {...}

local STATE_FILE = ".cairn_locomotion_test"
local TEST_VERSION = 2
local DISCOVERY_ATTEMPTS = 40
local DISCOVERY_DELAY = 0.25

local sides = {
    "left",
    "right",
    "top",
    "bottom",
    "front",
    "back"
}

local directions = {
    north = {
        forward = 2,
        backward = 3,
        left = 4,
        right = 5
    },
    south = {
        forward = 3,
        backward = 2,
        left = 5,
        right = 4
    },
    west = {
        forward = 4,
        backward = 5,
        left = 3,
        right = 2
    },
    east = {
        forward = 5,
        backward = 4,
        left = 2,
        right = 3
    }
}

local function saveState(state)
    local h = fs.open(STATE_FILE, "w")

    if not h then
        return false, "Could not open state file"
    end

    h.write(textutils.serialize(state))
    h.close()

    return true
end

local function loadState()
    if not fs.exists(STATE_FILE) then
        return nil
    end

    local h = fs.open(STATE_FILE, "r")

    if not h then
        error("Could not read saved locomotion state")
    end

    local raw = h.readAll()
    h.close()

    local state = textutils.unserialize(raw)

    if type(state) ~= "table" then
        error("Saved locomotion state is invalid")
    end

    return state
end

local function contains(list, wanted)
    if type(list) ~= "table" then
        return false
    end

    for _, value in ipairs(list) do
        if value == wanted then
            return true
        end
    end

    return false
end

local function addName(list, seen, name)
    if name and not seen[name] then
        seen[name] = true
        list[#list + 1] = name
    end
end

local function getNames()
    local names = {}
    local seen = {}

    for _, side in ipairs(sides) do
        if peripheral.isPresent(side) then
            addName(names, seen, side)
        end
    end

    if peripheral.getNames then
        local networkNames = peripheral.getNames()

        if type(networkNames) == "table" then
            for _, name in ipairs(networkNames) do
                addName(names, seen, name)
            end
        end
    end

    return names
end

local function inspectPeripheral(name)
    local typeName = peripheral.getType(name)
    local methods = peripheral.getMethods(name)

    return {
        name = name,
        typeName = typeName and tostring(typeName) or "unknown",
        methods = methods
    }
end

local function scorePeripheral(info)
    if not contains(info.methods, "move") then
        return nil
    end

    local probe = string.lower(info.name .. " " .. info.typeName)
    local score = 1

    if string.find(probe, "redstoneinmotion", 1, true) then
        score = score + 100
    end

    if string.find(probe, "carriagecontroller", 1, true) then
        score = score + 100
    end

    if string.find(probe, "carriage", 1, true) then
        score = score + 25
    end

    if string.find(probe, "controller", 1, true) then
        score = score + 10
    end

    return score
end

local function scanController()
    local names = getNames()
    local best = nil
    local bestScore = -1
    local moveCandidates = 0

    for _, name in ipairs(names) do
        local ok, info = pcall(inspectPeripheral, name)

        if ok and info then
            local score = scorePeripheral(info)

            if score then
                moveCandidates = moveCandidates + 1

                if score > bestScore then
                    best = info
                    bestScore = score
                end
            end
        end
    end

    if best and bestScore > 1 then
        return best
    end

    if best and moveCandidates == 1 then
        return best
    end

    if moveCandidates > 1 then
        return nil, "Multiple move-capable peripherals found"
    end

    return nil
end

local function findController()
    for attempt = 1, DISCOVERY_ATTEMPTS do
        local info, err = scanController()

        if info then
            return info
        end

        if err then
            return nil, err
        end

        if attempt < DISCOVERY_ATTEMPTS then
            sleep(DISCOVERY_DELAY)
        end
    end

    return nil, "No carriage controller found"
end

local function printPeripheralList()
    local names = getNames()

    print("Detected peripherals:")

    if #names == 0 then
        print("  none")
        return
    end

    for _, name in ipairs(names) do
        local ok, info = pcall(inspectPeripheral, name)

        if ok and info then
            local methods = ""

            if type(info.methods) == "table" then
                methods = table.concat(info.methods, ",")
            end

            print("  " .. info.name .. " [" .. info.typeName .. "]")
            print("    " .. methods)
        else
            print("  " .. tostring(name) .. " [inspection failed]")
        end
    end
end

local function callMove(name, direction, simulate)
    local result = {
        pcall(
            peripheral.call,
            name,
            "move",
            direction,
            simulate,
            false
        )
    }

    local callWorked = table.remove(result, 1)

    if not callWorked then
        return false, tostring(result[1] or "Peripheral call failed")
    end

    if result[1] == false then
        local pieces = {}

        for i = 2, #result do
            pieces[#pieces + 1] = tostring(result[i])
        end

        return false, table.concat(pieces, " ")
    end

    return true
end

local function buildMoves(forward)
    local d = directions[forward]

    local plan = {
        {"Raise", 1, 5},
        {"Forward", d.forward, 5},
        {"Backward", d.backward, 10},
        {"Forward", d.forward, 5},
        {"Left", d.left, 5},
        {"Right", d.right, 10},
        {"Left", d.left, 5},
        {"Lower", 0, 5}
    }

    local moves = {}

    for _, segment in ipairs(plan) do
        for step = 1, segment[3] do
            moves[#moves + 1] = {
                label = segment[1] .. " " .. step .. "/" .. segment[3],
                direction = segment[2]
            }
        end
    end

    return moves
end

local function chooseForward()
    if args[1] and args[1] ~= "--resume" then
        local supplied = string.lower(args[1])

        if directions[supplied] then
            return supplied
        end
    end

    print("Which world direction is the FRONT of Cairn facing?")
    write("north/south/east/west: ")

    local answer = read()

    if not answer then
        return nil
    end

    answer = string.lower(answer)

    if directions[answer] then
        return answer
    end

    return nil
end

local function main()
    print("CAIRN locomotion test v2")
    print("")

    if args[1] == "reset" then
        if fs.exists(STATE_FILE) then
            fs.delete(STATE_FILE)
        end

        print("Locomotion test state cleared")
        return
    end

    local state = loadState()

    if state then
        print("Saved test state found")
        print("Forward: " .. tostring(state.forward))
        print("Next step: " .. tostring(state.index))
        print("")
    else
        local forward = chooseForward()

        if not forward then
            print("Invalid forward direction")
            return
        end

        state = {
            version = TEST_VERSION,
            forward = forward,
            index = 1
        }

        local saved, err = saveState(state)

        if not saved then
            error(err or "Could not save locomotion state")
        end

        print("")
        print("Test initialized")
        print("Forward: " .. forward)
        print("Total moves: 50")
        print("")
    end

    if state.version ~= TEST_VERSION then
        print("Saved state belongs to another test version")
        print("Run: locomotion_test reset")
        return
    end

    if not directions[state.forward] then
        error("Saved forward direction is invalid")
    end

    if type(state.index) ~= "number" then
        error("Saved movement index is invalid")
    end

    local moves = buildMoves(state.forward)

    if state.index > #moves then
        if fs.exists(STATE_FILE) then
            fs.delete(STATE_FILE)
        end

        print("Test complete")
        return
    end

    print("Looking for carriage controller...")

    local controller, findErr = findController()

    if not controller then
        print("")
        print("Controller discovery failed")
        print(findErr or "")
        print("")
        printPeripheralList()
        return
    end

    print("Controller found")
    print("Name: " .. controller.name)
    print("Type: " .. controller.typeName)
    print("")

    local move = moves[state.index]

    print(
        "Step " ..
        state.index ..
        "/" ..
        #moves ..
        ": " ..
        move.label
    )

    local simulated, simErr = callMove(
        controller.name,
        move.direction,
        true
    )

    if not simulated then
        print("Simulation failed")

        if simErr and simErr ~= "" then
            print(simErr)
        end

        return
    end

    print("Simulation passed")

    local currentIndex = state.index
    state.index = state.index + 1

    local saved, saveErr = saveState(state)

    if not saved then
        state.index = currentIndex
        error(saveErr or "Could not save next movement state")
    end

    print("Moving...")

    local moved, moveErr = callMove(
        controller.name,
        move.direction,
        false
    )

    if not moved then
        state.index = currentIndex
        saveState(state)

        print("Move failed")

        if moveErr and moveErr ~= "" then
            print(moveErr)
        end

        print("State restored to step " .. currentIndex)
        return
    end

    print("Move command returned without reboot")
    print("Waiting for next step...")
    sleep(1)

    shell.run("locomotion_test", "--resume")
end

local ok, err = pcall(main)

if not ok then
    print("")
    print("CAIRN locomotion test error:")
    print(tostring(err))
end
