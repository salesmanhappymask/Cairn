local CAIRN_RELEASE = 7
local args = {...}

local DRIVE_SIDE = "back"
local STATE_FILE = ".cairn_locomotion_test"
local STATE_VERSION = 1

local channels = {
    up = colors.white,
    forward = colors.orange,
    right = colors.magenta,
    left = colors.lightBlue,
    back = colors.yellow,
    down = colors.lime
}

local plan = {
    {"Raise", "up", 5},
    {"Forward", "forward", 5},
    {"Backward", "back", 10},
    {"Forward", "forward", 5},
    {"Left", "left", 5},
    {"Right", "right", 10},
    {"Left", "left", 5},
    {"Lower", "down", 5}
}

print("CAIRN locomotion test")
print("Release: v" .. CAIRN_RELEASE)
print("Bundled drive only")
print("")

if not redstone then
    print("ERROR: redstone API is unavailable")
    return
end

if type(redstone.setBundledOutput) ~= "function" then
    print("ERROR: redstone.setBundledOutput is unavailable")
    return
end

local function saveState(state)
    local h = fs.open(STATE_FILE, "w")

    if not h then
        return false
    end

    h.write(textutils.serialize(state))
    h.close()
    return true
end

local function loadState()
    if not fs.exists(STATE_FILE) then
        return nil
    end

    local h = fs.open(STATE_FILE, "r")

    if not h then
        return nil
    end

    local raw = h.readAll()
    h.close()

    return textutils.unserialize(raw)
end

local function clearDrive()
    redstone.setBundledOutput(DRIVE_SIDE, 0)
end

local function buildMoves()
    local moves = {}

    for _, segment in ipairs(plan) do
        for i = 1, segment[3] do
            moves[#moves + 1] = {
                label = segment[1] .. " " .. i .. "/" .. segment[3],
                direction = segment[2]
            }
        end
    end

    return moves
end

if args[1] == "reset" then
    print("Resetting locomotion test...")

    local ok, err = pcall(clearDrive)

    if not ok then
        print("WARNING: could not clear bundled output")
        print(tostring(err))
    end

    if fs.exists(STATE_FILE) then
        fs.delete(STATE_FILE)
    end

    print("Locomotion test state cleared")
    return
end

print("Checking bundled output...")

local clearOk, clearErr = pcall(clearDrive)

if not clearOk then
    print("ERROR clearing bundled output:")
    print(tostring(clearErr))
    return
end

print("Bundled output ready")
print("")

local state = loadState()

if not state then
    state = {
        version = STATE_VERSION,
        step = 1,
        phase = "idle"
    }

    if not saveState(state) then
        print("ERROR: could not create locomotion state")
        return
    end

    print("Test initialized")
    print("Total moves: 50")
    print("")
end

if state.version ~= STATE_VERSION then
    print("ERROR: incompatible saved state")
    print("Run: locomotion_test reset")
    return
end

if state.phase == "armed" then
    print("Previous movement did not reboot cleanly")
    print("Returning that movement to pending state")
    state.phase = "idle"

    if not saveState(state) then
        print("ERROR: could not repair saved state")
        return
    end
end

local moves = buildMoves()

if state.step > #moves then
    clearDrive()

    if fs.exists(STATE_FILE) then
        fs.delete(STATE_FILE)
    end

    print("Test complete")
    return
end

local move = moves[state.step]
local channel = channels[move.direction]

print("Step " .. state.step .. "/" .. #moves)
print(move.label)
print("Direction: " .. move.direction)
print("Bundled value: " .. tostring(channel))
print("")

state.phase = "armed"

if not saveState(state) then
    print("ERROR: could not arm movement state")
    return
end

print("Energizing movement channel...")

local moveOk, moveErr = pcall(
    redstone.setBundledOutput,
    DRIVE_SIDE,
    channel
)

if not moveOk then
    state.phase = "idle"
    saveState(state)

    print("ERROR setting bundled output:")
    print(tostring(moveErr))
    return
end

print("Signal applied")
print("Waiting for carriage movement/reboot...")

sleep(3)

local offOk, offErr = pcall(clearDrive)

state.phase = "idle"
saveState(state)

if not offOk then
    print("WARNING: failed to clear output")
    print(tostring(offErr))
end

print("")
print("No reboot detected")
print("Movement remains pending at step " .. state.step)
