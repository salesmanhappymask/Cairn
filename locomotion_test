local CAIRN_RELEASE = 6
local args = {...}

local DRIVE_SIDE = "back"
local STATE_FILE = ".cairn_locomotion_test"
local STATE_VERSION = 1
local NO_REBOOT_TIMEOUT = 3

local channels = {
    up = colors.white,
    forward = colors.orange,
    right = colors.magenta,
    left = colors.lightBlue,
    back = colors.yellow,
    down = colors.lime
}

local plan = {
    {"Raise", "up", 5},
    {"Forward", "forward", 5},
    {"Backward", "back", 10},
    {"Forward", "forward", 5},
    {"Left", "left", 5},
    {"Right", "right", 10},
    {"Left", "left", 5},
    {"Lower", "down", 5}
}

local function saveState(state)
    local h = fs.open(STATE_FILE, "w")

    if not h then
        return false
    end

    h.write(textutils.serialize(state))
    h.close()
    return true
end

local function loadState()
    if not fs.exists(STATE_FILE) then
        return nil
    end

    local h = fs.open(STATE_FILE, "r")

    if not h then
        return nil
    end

    local raw = h.readAll()
    h.close()

    return textutils.unserialize(raw)
end

local function clearDrive()
    redstone.setBundledOutput(DRIVE_SIDE, 0)
end

local function buildMoves()
    local moves = {}

    for _, segment in ipairs(plan) do
        for i = 1, segment[3] do
            moves[#moves + 1] = {
                label = segment[1] .. " " .. i .. "/" .. segment[3],
                direction = segment[2]
            }
        end
    end

    return moves
end

local function main()
    clearDrive()

    print("CAIRN locomotion test")
    print("Release: v" .. CAIRN_RELEASE)
    print("Drive: bundled RedNet on " .. DRIVE_SIDE)
    print("")

    if args[1] == "reset" then
        clearDrive()

        if fs.exists(STATE_FILE) then
            fs.delete(STATE_FILE)
        end

        print("Locomotion test state cleared")
        return
    end

    local state = loadState()

    if not state then
        state = {
            version = STATE_VERSION,
            step = 1,
            phase = "idle"
        }

        if not saveState(state) then
            print("Could not create locomotion state")
            return
        end

        print("Test initialized")
        print("Total moves: 50")
        print("")
    end

    if state.version ~= STATE_VERSION then
        print("Saved state is incompatible")
        print("Run: locomotion_test reset")
        return
    end

    if state.phase == "armed" then
        print("An armed movement was found without a reboot")
        print("Clearing propulsion output and retrying the same step")
        state.phase = "idle"
        clearDrive()

        if not saveState(state) then
            print("Could not repair locomotion state")
            return
        end
    end

    local moves = buildMoves()

    if state.step > #moves then
        clearDrive()

        if fs.exists(STATE_FILE) then
            fs.delete(STATE_FILE)
        end

        print("Test complete")
        return
    end

    local move = moves[state.step]
    local channel = channels[move.direction]

    if not channel then
        print("Invalid movement channel")
        return
    end

    print("Step " .. state.step .. "/" .. #moves)
    print(move.label)
    print("Direction: " .. move.direction)
    print("Channel: " .. tostring(channel))
    print("")

    clearDrive()
    sleep(0.1)

    state.phase = "armed"

    if not saveState(state) then
        print("Could not arm movement transaction")
        return
    end

    print("Moving...")
    redstone.setBundledOutput(DRIVE_SIDE, channel)

    sleep(NO_REBOOT_TIMEOUT)

    clearDrive()

    local current = loadState()

    if current and current.phase == "armed" then
        current.phase = "idle"
        saveState(current)
    end

    print("")
    print("No carriage reboot detected")
    print("The drive signal was cleared")
    print("Movement remains on step " .. state.step)
end

local ok, err = pcall(main)

if not ok then
    pcall(redstone.setBundledOutput, DRIVE_SIDE, 0)
    print("")
    print("CAIRN locomotion error:")
    print(tostring(err))
end
