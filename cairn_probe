local CAIRN_RELEASE = 4

local sides = {
    "left",
    "right",
    "top",
    "bottom",
    "front",
    "back"
}

local function safeType(name)
    local ok, value = pcall(peripheral.getType, name)

    if not ok then
        return "ERROR: " .. tostring(value)
    end

    if value == nil then
        return "nil"
    end

    return tostring(value)
end

local function safeMethods(name)
    local ok, value = pcall(peripheral.getMethods, name)

    if not ok then
        return "ERROR: " .. tostring(value)
    end

    if type(value) ~= "table" then
        return "none"
    end

    return table.concat(value, ", ")
end

print("CAIRN probe v" .. CAIRN_RELEASE)
print("Computer ID: " .. tostring(os.getComputerID()))
print("")

if fs.exists(".cairn_version") then
    local h = fs.open(".cairn_version", "r")

    if h then
        print("Installed release record: v" .. tostring(h.readAll()))
        h.close()
    else
        print("Installed release record: unreadable")
    end
else
    print("Installed release record: missing")
end

print("")
print("Program files:")
print("  startup: " .. tostring(fs.exists("startup")))
print("  locomotion_test: " .. tostring(fs.exists("locomotion_test")))
print("  cairn_probe: " .. tostring(fs.exists("cairn_probe")))
print("  update: " .. tostring(fs.exists("update")))
print("")

print("Direct peripherals:")

local directCount = 0

for _, side in ipairs(sides) do
    if peripheral.isPresent(side) then
        directCount = directCount + 1
        print("  " .. side .. " [" .. safeType(side) .. "]")
        print("    " .. safeMethods(side))
    end
end

if directCount == 0 then
    print("  none")
end

print("")
print("All peripheral names:")

if peripheral.getNames then
    local ok, names = pcall(peripheral.getNames)

    if ok and type(names) == "table" then
        if #names == 0 then
            print("  none")
        else
            for _, name in ipairs(names) do
                print("  " .. tostring(name) .. " [" .. safeType(name) .. "]")
                print("    " .. safeMethods(name))
            end
        end
    else
        print("  peripheral.getNames failed")
        print("  " .. tostring(names))
    end
else
    print("  peripheral.getNames is unavailable")
end

print("")
print("Probe complete")
