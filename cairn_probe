local CAIRN_RELEASE = 5

local sides = {
    "left",
    "right",
    "top",
    "bottom",
    "front",
    "back"
}

local function getType(name)
    local ok, value = pcall(peripheral.getType, name)

    if not ok then
        return "ERROR: " .. tostring(value)
    end

    return tostring(value)
end

local function getMethods(name)
    local ok, value = pcall(peripheral.getMethods, name)

    if not ok then
        return "ERROR: " .. tostring(value)
    end

    if type(value) ~= "table" then
        return "none"
    end

    return table.concat(value, ", ")
end

print("CAIRN probe")
print("Release: v" .. CAIRN_RELEASE)
print("Computer ID: " .. tostring(os.getComputerID()))
print("")

print("Direct peripherals:")

local direct = 0

for _, side in ipairs(sides) do
    if peripheral.isPresent(side) then
        direct = direct + 1
        print("  " .. side)
        print("    type: " .. getType(side))
        print("    methods: " .. getMethods(side))
    end
end

if direct == 0 then
    print("  none")
end

print("")
print("Network peripheral names:")

if peripheral.getNames then
    local ok, names = pcall(peripheral.getNames)

    if ok and type(names) == "table" then
        if #names == 0 then
            print("  none")
        end

        for _, name in ipairs(names) do
            print("  " .. tostring(name))
            print("    type: " .. getType(name))
            print("    methods: " .. getMethods(name))
        end
    else
        print("  getNames failed")
        print("  " .. tostring(names))
    end
else
    print("  peripheral.getNames unavailable")
end

print("")
print("Expected RIM methods:")
print("  move")
print("  anchored_move")
print("  check_anchored_move")
print("  unanchored_move")
print("  check_unanchored_move")
print("")
print("Probe complete")
