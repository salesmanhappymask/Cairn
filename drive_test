local CAIRN_RELEASE = 8
local DRIVE_SIDE = "back"

local signals = {
    up = 1,
    forward = 2,
    right = 3,
    left = 4,
    back = 5,
    down = 6
}

print("CAIRN analog drive test")
print("Release: v" .. CAIRN_RELEASE)
print("Output side: " .. DRIVE_SIDE)
print("")

if not redstone then
    print("ERROR: redstone API is unavailable")
    return
end

if type(redstone.setAnalogOutput) ~= "function" then
    print("ERROR: redstone.setAnalogOutput is unavailable")
    return
end

if type(redstone.getAnalogOutput) ~= "function" then
    print("ERROR: redstone.getAnalogOutput is unavailable")
    return
end

print("Analog redstone API detected")

local ok, value = pcall(redstone.getAnalogOutput, DRIVE_SIDE)

if not ok then
    print("ERROR reading analog output:")
    print(tostring(value))
    return
end

print("Current output strength: " .. tostring(value))
print("")
print("Choose one direction:")
print("up       = strength 1")
print("forward  = strength 2")
print("right    = strength 3")
print("left     = strength 4")
print("back     = strength 5")
print("down     = strength 6")
print("off      = strength 0")
write("> ")

local choice = string.lower(read() or "")

if choice == "off" then
    local clearOk, clearErr = pcall(redstone.setAnalogOutput, DRIVE_SIDE, 0)

    if not clearOk then
        print("ERROR clearing analog output:")
        print(tostring(clearErr))
        return
    end

    print("Analog output cleared")
    return
end

local strength = signals[choice]

if not strength then
    print("Unknown direction")
    return
end

print("")
print("Selected strength: " .. strength)
print("Press Enter to energize the output")
read()

local clearOk, clearErr = pcall(redstone.setAnalogOutput, DRIVE_SIDE, 0)

if not clearOk then
    print("ERROR clearing output before test:")
    print(tostring(clearErr))
    return
end

sleep(0.25)

print("Outputting strength " .. strength .. "...")

local setOk, setErr = pcall(redstone.setAnalogOutput, DRIVE_SIDE, strength)

if not setOk then
    print("ERROR setting analog output:")
    print(tostring(setErr))
    return
end

print("Signal set successfully")
print("If the carriage moves, this computer may reboot now")

sleep(3)

redstone.setAnalogOutput(DRIVE_SIDE, 0)
print("No reboot occurred")
print("Signal cleared")
