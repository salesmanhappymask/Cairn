local CAIRN_RELEASE = 27

local CONTROL_ID = 2705
local SLAVE_ID = 2701

local CONTROL_PROTOCOL = "cairn.nav.command"
local CONTROL_REPLY_PROTOCOL = "cairn.nav.reply"

local BROADCAST_ATTEMPTS = 18
local BROADCAST_WAIT = 0.10

local SIDES = {
    "top",
    "bottom",
    "left",
    "right",
    "front",
    "back"
}

local requestSequence = 0
local activity = "Ready"
local lastStatus = nil
local buttons = {}

local function findWirelessModem()
    for _, side in ipairs(SIDES) do
        if peripheral.getType(side) == "modem" then
            local ok, wireless = pcall(
                peripheral.call,
                side,
                "isWireless"
            )

            if ok and wireless == true then
                return side
            end
        end
    end

    return nil
end

local function openWireless()
    local side = findWirelessModem()

    if not side then
        return nil
    end

    if not rednet.isOpen(side) then
        rednet.open(side)
    end

    return side
end

local function nextToken()
    requestSequence = requestSequence + 1

    return
        tostring(CONTROL_ID) ..
        ":" ..
        tostring(requestSequence) ..
        ":" ..
        tostring(math.floor(os.clock() * 1000))
end

local function positionText(position)
    if type(position) ~= "table" then
        return "unknown"
    end

    return
        "X " ..
        tostring(position.x) ..
        " Y " ..
        tostring(position.y) ..
        " Z " ..
        tostring(position.z)
end

local function trim(value, width)
    value = tostring(value or "")

    if #value <= width then
        return value
    end

    if width <= 3 then
        return string.sub(value, 1, width)
    end

    return string.sub(value, 1, width - 3) .. "..."
end

local function writeLine(y, value)
    local width = term.getSize()

    term.setCursorPos(1, y)
    term.clearLine()
    write(trim(value, width))
end

local function drawActivity()
    local _, height = term.getSize()
    writeLine(height, "STATUS: " .. activity)
end

local function setActivity(value)
    activity = value
    drawActivity()
end

local function setBackground(value)
    local fn = term.setBackgroundColor or term.setBackgroundColour

    if fn then
        fn(value)
    end
end

local function setText(value)
    local fn = term.setTextColor or term.setTextColour

    if fn then
        fn(value)
    end
end

local function resetColors()
    setBackground(colors.black)
    setText(colors.white)
end

local function addButton(id, label, x1, y1, x2, y2, background)
    buttons[#buttons + 1] = {
        id = id,
        x1 = x1,
        y1 = y1,
        x2 = x2,
        y2 = y2
    }

    setBackground(background or colors.gray)
    setText(colors.white)

    for y = y1, y2 do
        term.setCursorPos(x1, y)
        write(string.rep(" ", x2 - x1 + 1))
    end

    local width = x2 - x1 + 1
    local text = trim(label, width - 2)
    local tx = x1 + math.floor((width - #text) / 2)
    local ty = y1 + math.floor((y2 - y1) / 2)

    term.setCursorPos(tx, ty)
    write(text)

    resetColors()
end

local function drawButtons()
    buttons = {}

    local width, height = term.getSize()
    local gap = 1
    local left = 1
    local usable = width - 2 * left - 2 * gap
    local buttonWidth = math.floor(usable / 3)

    if buttonWidth < 10 then
        buttonWidth = 10
    end

    local x1 = left
    local x2 = x1 + buttonWidth + gap
    local x3 = x2 + buttonWidth + gap
    local row1 = 9
    local row2 = 12
    local row3 = 15

    addButton("destination", "DESTINATION", x1, row1, x1 + buttonWidth - 1, row1 + 1, colors.blue)
    addButton("pause", "PAUSE", x2, row1, x2 + buttonWidth - 1, row1 + 1, colors.orange)
    addButton("resume", "RESUME", x3, row1, math.min(width, x3 + buttonWidth - 1), row1 + 1, colors.green)

    addButton("cancel", "CANCEL", x1, row2, x1 + buttonWidth - 1, row2 + 1, colors.red)
    addButton("return_origin", "RETURN", x2, row2, x2 + buttonWidth - 1, row2 + 1, colors.purple)
    addButton("position", "SET POSITION", x3, row2, math.min(width, x3 + buttonWidth - 1), row2 + 1, colors.cyan)

    addButton("update", "UPDATE", x1, row3, x1 + buttonWidth - 1, row3 + 1, colors.brown)
    addButton("refresh", "REFRESH", x2, row3, x2 + buttonWidth - 1, row3 + 1, colors.gray)
    addButton("exit", "EXIT", x3, row3, math.min(width, x3 + buttonWidth - 1), row3 + 1, colors.gray)

    if height < 18 then
        activity = trim(activity, width - 8)
    end
end

local function draw()
    resetColors()
    term.clear()
    term.setCursorPos(1, 1)

    print("CAIRN NAV CONTROL 2705")

    if lastStatus then
        print(
            "Drive1 relay: ONLINE   Platform v" ..
            tostring(lastStatus.release or "?")
        )
        print("Current: " .. positionText(lastStatus.current))
        print("Dest:    " .. positionText(lastStatus.destination))
        print(
            "Cruise " ..
            tostring(lastStatus.cruise or "?") ..
            "  Mode " ..
            tostring(lastStatus.routeMode or "idle")
        )
        print(
            "Stage " ..
            tostring(lastStatus.stage or "idle") ..
            "  Paused " ..
            (lastStatus.paused and "YES" or "NO")
        )

        if lastStatus.transaction then
            print(
                "Move " ..
                tostring(lastStatus.transaction.direction) ..
                " / " ..
                tostring(lastStatus.transaction.phase)
            )
        else
            print("Move none")
        end
    else
        print("Drive1 relay/platform: NO STATUS")
        print("Current: unknown")
        print("Dest:    unknown")
        print("Cruise ?  Mode ?")
        print("Stage ?  Paused ?")
        print("Move unknown")
    end

    drawButtons()
    drawActivity()
end

local function request(command, label, quiet)
    local token = nextToken()

    command.token = token

    local relaySeen = false

    for attempt = 1, BROADCAST_ATTEMPTS do
        if not quiet then
            if relaySeen then
                setActivity(
                    "Drive1 received " ..
                    label ..
                    "; awaiting Drive2"
                )
            else
                setActivity(
                    "Broadcasting " ..
                    label ..
                    " " ..
                    attempt ..
                    "/" ..
                    BROADCAST_ATTEMPTS
                )
            end
        end

        rednet.broadcast(
            command,
            CONTROL_PROTOCOL
        )

        local deadline = os.clock() + BROADCAST_WAIT

        while os.clock() < deadline do
            local sender, message = rednet.receive(
                CONTROL_REPLY_PROTOCOL,
                deadline - os.clock()
            )

            if not sender then
                break
            end

            if
                sender == SLAVE_ID and
                type(message) == "table" and
                message.token == token
            then
                if message.type == "relay_ack" then
                    relaySeen = true

                    if not quiet then
                        setActivity(
                            "Drive1 heard " ..
                            label ..
                            "; relaying"
                        )
                    end
                else
                    if not quiet then
                        setActivity(
                            message.message or
                            (label .. " acknowledged")
                        )
                    end

                    return message
                end
            end
        end
    end

    if relaySeen then
        setActivity(
            "Drive1 heard command; no Drive2 reply yet"
        )
    else
        setActivity(
            "No response from Drive1 relay"
        )
    end

    return nil
end

local function refreshStatus(quiet)
    local reply = request(
        {
            command = "status"
        },
        "STATUS",
        quiet == true
    )

    if reply and reply.type == "status" then
        lastStatus = reply

        if quiet then
            activity = "Live status updated"
        end
    end

    draw()

    return reply
end

local function askInteger(label)
    while true do
        write(label .. ": ")
        local raw = read()
        local value = tonumber(raw)

        if value and value == math.floor(value) then
            return value
        end

        print("Please enter a whole number.")
    end
end

local function commandDestination()
    resetColors()
    term.clear()
    term.setCursorPos(1, 1)

    print("ONE-WAY DESTINATION")
    print("")
    print("Current: " .. positionText(lastStatus and lastStatus.current))
    print("")

    local x = askInteger("Destination X")
    local y = askInteger("Destination Y")
    local z = askInteger("Destination Z")
    local cruise = askInteger("Cruise altitude Y")

    activity = "Destination selected"

    return request(
        {
            command = "set_destination",
            x = x,
            y = y,
            z = z,
            cruise = cruise
        },
        "DESTINATION",
        false
    )
end

local function commandPosition()
    resetColors()
    term.clear()
    term.setCursorPos(1, 1)

    print("SET AUTHORITATIVE POSITION")
    print("")
    print("Use only when the platform is physically")
    print("at the coordinates entered.")
    print("")

    local x = askInteger("X")
    local y = askInteger("Y")
    local z = askInteger("Z")

    activity = "Position selected"

    return request(
        {
            command = "set_position",
            x = x,
            y = y,
            z = z
        },
        "POSITION",
        false
    )
end

local function commandReturn()
    resetColors()
    term.clear()
    term.setCursorPos(1, 1)

    print("RETURN TO ROUTE ORIGIN")
    print("")
    print(
        "Origin: " ..
        positionText(lastStatus and lastStatus.origin)
    )
    print("")

    local cruise = askInteger("Cruise altitude Y")

    activity = "Return selected"

    return request(
        {
            command = "return_origin",
            cruise = cruise
        },
        "RETURN",
        false
    )
end

local function commandUpdate()
    resetColors()
    term.clear()
    term.setCursorPos(1, 1)

    print("FORCE PLATFORM UPDATE")
    print("")
    print("Drive1 will relay this to Drive2.")
    print("Drive2 will update Drive1, then itself.")
    print("")
    print("Type YES to continue.")

    local answer = string.upper(read() or "")

    if answer ~= "YES" then
        activity = "Update cancelled"
        return nil
    end

    activity = "Update selected"

    return request(
        {
            command = "force_update"
        },
        "UPDATE",
        false
    )
end

local function handleAction(id)
    if id == "destination" then
        commandDestination()

    elseif id == "pause" then
        setActivity("Pause selected")
        request(
            {
                command = "pause"
            },
            "PAUSE",
            false
        )

    elseif id == "resume" then
        setActivity("Resume selected")
        request(
            {
                command = "resume"
            },
            "RESUME",
            false
        )

    elseif id == "cancel" then
        setActivity("Cancel selected")
        request(
            {
                command = "cancel"
            },
            "CANCEL",
            false
        )

    elseif id == "return_origin" then
        commandReturn()

    elseif id == "position" then
        commandPosition()

    elseif id == "update" then
        commandUpdate()

    elseif id == "refresh" then
        setActivity("Refresh selected")
        refreshStatus(false)

    elseif id == "exit" then
        return false
    end

    if id ~= "refresh" then
        refreshStatus(true)
    end

    return true
end

local function clickedButton(x, y)
    for _, button in ipairs(buttons) do
        if
            x >= button.x1 and
            x <= button.x2 and
            y >= button.y1 and
            y <= button.y2
        then
            return button.id
        end
    end

    return nil
end

if os.getComputerID() ~= CONTROL_ID then
    term.clear()
    term.setCursorPos(1, 1)
    print("CAIRN NAV CONTROL")
    print("")
    print("Reserved for computer 2705.")
    print("Current ID: " .. os.getComputerID())
    return
end

local wirelessSide = openWireless()

if not wirelessSide then
    term.clear()
    term.setCursorPos(1, 1)
    print("CAIRN NAV CONTROL")
    print("")
    print("No wireless modem found.")
    return
end

activity = "Wireless modem " .. wirelessSide
refreshStatus(false)

local refreshTimer = os.startTimer(1.5)

while true do
    local event, a, b, c = os.pullEvent()

    if event == "mouse_click" then
        local id = clickedButton(b, c)

        if id then
            if not handleAction(id) then
                break
            end

            refreshTimer = os.startTimer(1.5)
        end

    elseif event == "char" then
        local key = string.lower(a)
        local map = {
            ["1"] = "destination",
            ["2"] = "pause",
            ["3"] = "resume",
            ["4"] = "cancel",
            ["5"] = "return_origin",
            ["6"] = "position",
            ["u"] = "update",
            ["r"] = "refresh",
            ["q"] = "exit"
        }

        if map[key] then
            if not handleAction(map[key]) then
                break
            end

            refreshTimer = os.startTimer(1.5)
        end

    elseif event == "timer" and a == refreshTimer then
        refreshStatus(true)
        refreshTimer = os.startTimer(1.5)
    end
end

resetColors()
term.clear()
term.setCursorPos(1, 1)
print("CAIRN control offline")
