local function returnOrigin()
    resetColors()
    term.clear()
    term.setCursorPos(1, 1)

    print("RETURN TO ORIGIN")
    print("")

    if lastStatus and lastStatus.origin then
        print(
            "Origin: " ..
            position(lastStatus.origin)
        )
    end

    print("")

    local cruise = askInteger("Cruise Y")

    return requestCommand(
        {
            command = "return_origin",
            cruise = cruise
        },
        "RETURN"
    )
end

local function updatePlatform()
    resetColors()
    term.clear()
    term.setCursorPos(1, 1)

    print("FORCE PLATFORM UPDATE")
    print("")
    print("Drive1 relays this to Drive2.")
    print("Drive2 updates Drive1, then itself.")
    print("")
    print("Type YES to continue.")

    local answer = string.upper(read() or "")

    if answer ~= "YES" then
        setActivity(
            "Update cancelled",
            "No changes made"
        )
        return nil
    end

    return requestCommand(
        {
            command = "force_update"
        },
        "UPDATE"
    )
end

local function handle(id)
    local reply = nil

    if id == "destination" then
        setActivity(
            "Destination selected",
            "Entering coordinates"
        )
        reply = destination()

    elseif id == "quarry" then
        setActivity(
            "Quarry selected",
            "Entering destination"
        )
        reply = quarry()

    elseif id == "pause" then
        setActivity(
            "Pause selected",
            "Broadcast starting"
        )
        reply = requestCommand(
            {
                command = "pause"
            },
            "PAUSE"
        )

    elseif id == "resume" then
        setActivity(
            "Resume selected",
            "Broadcast starting"
        )
        reply = requestCommand(
            {
                command = "resume"
            },
            "RESUME"
        )

    elseif id == "cancel" then
        setActivity(
            "Cancel selected",
            "Broadcast starting"
        )
        reply = requestCommand(
            {
                command = "cancel"
            },
            "CANCEL"
        )

    elseif id == "return" then
        setActivity(
            "Return selected",
            "Entering cruise altitude"
        )
        reply = returnOrigin()

    elseif id == "position" then
        setActivity(
            "Set position selected",
            "Entering coordinates"
        )
        reply = setPosition()

    elseif id == "update" then
        setActivity(
            "Update selected",
            "Awaiting confirmation"
        )
        reply = updatePlatform()

    elseif id == "refresh" then
        refreshStatus()
        return true

    elseif id == "exit" then
        return false
    end

    if reply then
        local status = requestStatus()

        if status and status.type == "status" then
            lastStatus = status
        end
    end

    draw()

    return true
end

local function hit(x, y)
    for _, button in ipairs(buttons) do
        if
            x >= button.x1 and
            x <= button.x2 and
            y >= button.y1 and
            y <= button.y2
        then
            return button.id
        end
    end

    return nil
end

if os.getComputerID() ~= CONTROL_ID then
    term.clear()
    term.setCursorPos(1, 1)
    print("CAIRN NAV")
    print("")
    print("Reserved for computer 2705.")
    print("Current ID: " .. os.getComputerID())
    return
end

local wirelessSide = openWireless()

if not wirelessSide then
    term.clear()
    term.setCursorPos(1, 1)
    print("CAIRN NAV")
    print("")
    print("No wireless modem found.")
    return
end

activity = "Starting"
detail = "Wireless modem " .. wirelessSide

refreshStatus()

local timer = os.startTimer(2.5)

while true do
    local event, a, b, c = os.pullEvent()

    if event == "mouse_click" then
        local id = hit(b, c)

        if id then
            if not handle(id) then
                break
            end

            timer = os.startTimer(2.5)
        end

    elseif event == "char" then
        local key = string.lower(a)

        local shortcuts = {
            ["1"] = "destination",
            ["7"] = "quarry",
            ["2"] = "pause",
            ["3"] = "resume",
            ["4"] = "cancel",
            ["5"] = "return",
            ["6"] = "position",
            ["u"] = "update",
            ["r"] = "refresh",
            ["q"] = "exit"
        }

        if shortcuts[key] then
            if not handle(shortcuts[key]) then
                break
            end

            timer = os.startTimer(2.5)
        end

    elseif event == "timer" and a == timer then
        local status = requestStatus()

        if status and status.type == "status" then
            lastStatus = status
        end

        draw()
        timer = os.startTimer(2.5)
    end
end

resetColors()
term.clear()
term.setCursorPos(1, 1)
print("CAIRN control offline")
