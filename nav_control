local function draw()
    resetColors()
    term.clear()
    term.setCursorPos(1, 1)

    print("CAIRN NAV 2705")

    if lastStatus then
        print(
            "Platform v" ..
            tostring(lastStatus.release or "?") ..
            "  Relay OK"
        )

        print(
            "POS " ..
            position(lastStatus.current) ..
            "  CRZ " ..
            tostring(lastStatus.cruise or "?")
        )

        print(
            "DST " ..
            position(lastStatus.destination)
        )

        print(
            "STG " ..
            tostring(lastStatus.stage or "idle") ..
            "  " ..
            (lastStatus.paused and "PAUSED" or "RUNNING")
        )

        if lastStatus.quarry then
            print(
                "QRY " ..
                tostring(lastStatus.quarry.phase or "?") ..
                (lastStatus.quarry.error and
                    (" " .. tostring(lastStatus.quarry.error)) or
                    "")
            )
        elseif lastStatus.transaction then
            print(
                "MOVE " ..
                tostring(lastStatus.transaction.direction) ..
                " " ..
                tostring(lastStatus.transaction.phase)
            )
        else
            print("MOVE none")
        end
    else
        print("Platform status unavailable")
        print("POS unknown")
        print("DST unknown")
        print("STG unknown")
        print("MOVE unknown")
    end

    drawButtons()
    drawActivity()
end

local function request(payload, label, sends, interval)
    local token = nextToken()

    payload.token = token

    local relaySeen = false

    for attempt = 1, sends do
        setActivity(
            "Broadcasting " .. label,
            tostring(attempt) .. "/" .. tostring(sends)
        )

        rednet.broadcast(
            payload,
            CONTROL_PROTOCOL
        )

        local deadline = os.clock() + interval

        while os.clock() < deadline do
            local sender, message = rednet.receive(
                CONTROL_REPLY_PROTOCOL,
                deadline - os.clock()
            )

            if not sender then
                break
            end

            if
                sender == SLAVE_ID and
                type(message) == "table" and
                message.token == token
            then
                if message.type == "relay_ack" then
                    relaySeen = true

                    setActivity(
                        "Drive1 heard " .. label,
                        "Relaying to Drive2"
                    )

                else
                    setActivity(
                        message.ok == false
                            and "Command rejected"
                            or label .. " acknowledged",
                        message.message or "Drive2 replied"
                    )

                    return message
                end
            end
        end
    end

    if relaySeen then
        setActivity(
            label .. " reached Drive1",
            "No Drive2 reply yet"
        )
    else
        setActivity(
            label .. " not received",
            "No reply from Drive1"
        )
    end

    return nil
end

local function requestCommand(payload, label)
    return request(
        payload,
        label,
        COMMAND_SENDS,
        COMMAND_INTERVAL
    )
end

local function requestStatus()
    return request(
        {
            command = "status"
        },
        "STATUS",
        STATUS_SENDS,
        STATUS_INTERVAL
    )
end

local function refreshStatus()
    local reply = requestStatus()

    if reply and reply.type == "status" then
        lastStatus = reply
    end

    draw()
end

local function askInteger(label)
    while true do
        write(label .. ": ")

        local raw = read()
        local value = tonumber(raw)

        if value and value == math.floor(value) then
            return value
        end

        print("Whole number required.")
    end
end

local function destination()
    resetColors()
    term.clear()
    term.setCursorPos(1, 1)

    print("SET ONE-WAY DESTINATION")
    print("")
    print(
        "Current: " ..
        position(lastStatus and lastStatus.current)
    )
    print("")

    local x = askInteger("X")
    local y = askInteger("Y")
    local z = askInteger("Z")
    local cruise = askInteger("Cruise Y")

    return requestCommand(
        {
            command = "set_destination",
            x = x,
            y = y,
            z = z,
            cruise = cruise
        },
        "DESTINATION"
    )
end

