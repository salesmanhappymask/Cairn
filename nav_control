local function setPosition()
    resetColors()
    term.clear()
    term.setCursorPos(1, 1)

    print("SET CURRENT POSITION")
    print("")
    print("Only use at the platform's actual location.")
    print("")

    local x = askInteger("X")
    local y = askInteger("Y")
    local z = askInteger("Z")

    return requestCommand(
        {
            command = "set_position",
            x = x,
            y = y,
