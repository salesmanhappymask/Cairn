    resetColors()
    term.clear()
    term.setCursorPos(1, 1)

    print("SET QUARRY DESTINATION")
    print("")
    print(
        "Current: " ..
        position(lastStatus and lastStatus.current)
    )
    print("")
    print("Drive2 must start and arrive at the")
    print("bottom-left block inside a chunk.")
    print("")

