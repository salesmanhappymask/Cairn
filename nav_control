    )

    addButton(
        "resume",
        "RESUME",
        rightX,
        9,
        width,
        10,
        colors.green
    )

    addButton(
        "cancel",
        "CANCEL",
        1,
        11,
        leftWidth,
        12,
        colors.red
    )

    addButton(
        "return",
        "RETURN",
        rightX,
        11,
        width,
        12,
        colors.purple
    )

    addButton(
        "position",
