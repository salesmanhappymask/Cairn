local args = {...}

local RELEASE_VERSION = 8
local BASE_URL = "https://raw.githubusercontent.com/salesmanhappymask/Cairn/main/"
local TEMP_UPDATER = ".cairn_update_new"
local STAGE_DIR = ".cairn_update_stage"
local VERSION_FILE = ".cairn_version"

local FILES = {
    "startup",
    "locomotion_test",
    "drive_test",
    "update"
}

local function runningDir()
    if shell.getRunningProgram then
        return fs.getDir(shell.getRunningProgram())
    end
    return shell.dir()
end

local ROOT = runningDir()

local function fullPath(name)
    if ROOT == "" then
        return name
    end
    return fs.combine(ROOT, name)
end

local function readText(filePath)
    if not fs.exists(filePath) then
        return nil
    end

    local h = fs.open(filePath, "r")
    if not h then
        return nil
    end

    local data = h.readAll()
    h.close()
    return data
end

local function writeText(filePath, data)
    local h = fs.open(filePath, "w")
    if not h then
        return false
    end

    h.write(data)
    h.close()
    return true
end

local function token()
    return tostring(os.getComputerID()) .. "_" .. tostring(math.floor(os.clock() * 1000))
end

local function fetch(name)
    if not http or not http.get then
        return nil, "HTTP API unavailable"
    end

    local ok, handle, err = pcall(
        http.get,
        BASE_URL .. name .. "?cairn=" .. token()
    )

    if not ok then
        return nil, tostring(handle)
    end

    if not handle then
        return nil, tostring(err or "HTTP request failed")
    end

    local data = handle.readAll()
    handle.close()

    if not data or data == "" then
        return nil, "Empty response"
    end

    return data
end

local function validate(filePath)
    local fn, err = loadfile(filePath)

    if not fn then
        return false, err
    end

    return true
end

local function extractRelease(name, data)
    local pattern

    if name == "update" then
        pattern = "local%s+RELEASE_VERSION%s*=%s*(%d+)"
    else
        pattern = "local%s+CAIRN_RELEASE%s*=%s*(%d+)"
    end

    local value = string.match(data, pattern)

    if not value then
        return nil
    end

    return tonumber(value)
end

local function installedVersion()
    local data = readText(fullPath(VERSION_FILE))

    if not data then
        return "unknown"
    end

    data = string.gsub(data, "%s+", "")

    if data == "" then
        return "unknown"
    end

    return data
end

local function clearStage()
    if fs.exists(fullPath(STAGE_DIR)) then
        fs.delete(fullPath(STAGE_DIR))
    end
end

local function bootstrap()
    print("CAIRN updater")
    print("Installed release: v" .. installedVersion())
    print("Checking GitHub...")

    local data, err = fetch("update")

    if not data then
        print("Updater download failed")
        print(err or "")
        return
    end

    local release = extractRelease("update", data)

    if not release then
        print("Downloaded updater has no release number")
        return
    end

    print("Downloaded updater release: v" .. release)

    local temp = fullPath(TEMP_UPDATER)

    if fs.exists(temp) then
        fs.delete(temp)
    end

    if not writeText(temp, data) then
        print("Could not write temporary updater")
        return
    end

    local ok, syntaxErr = validate(temp)

    if not ok then
        fs.delete(temp)
        print("Downloaded updater failed validation")
        print(syntaxErr or "")
        return
    end

    print("Running downloaded updater...")
    shell.run(temp, "--apply")

    if fs.exists(temp) then
        fs.delete(temp)
    end
end

local function apply()
    print("Applying CAIRN release v" .. RELEASE_VERSION)

    clearStage()
    fs.makeDir(fullPath(STAGE_DIR))

    for _, name in ipairs(FILES) do
        print("Downloading " .. name)

        local data, err = fetch(name)

        if not data then
            clearStage()
            print("Download failed: " .. name)
            print(err or "")
            return
        end

        local release = extractRelease(name, data)

        if release ~= RELEASE_VERSION then
            clearStage()
            print("Release mismatch")
            print(name .. " is v" .. tostring(release) .. ", expected v" .. RELEASE_VERSION)
            print("GitHub may still be updating")
            return
        end

        local staged = fs.combine(fullPath(STAGE_DIR), name)

        if not writeText(staged, data) then
            clearStage()
            print("Could not stage " .. name)
            return
        end

        local ok, syntaxErr = validate(staged)

        if not ok then
            clearStage()
            print("Validation failed: " .. name)
            print(syntaxErr or "")
            return
        end
    end

    print("All files verified as v" .. RELEASE_VERSION)
    print("Clearing old installation...")

    local preserve = {
        [TEMP_UPDATER] = true,
        [STAGE_DIR] = true
    }

    for _, name in ipairs(fs.list(ROOT)) do
        local target = fullPath(name)

        if not preserve[name] and fs.getDrive(target) == "hdd" and not fs.isReadOnly(target) then
            fs.delete(target)
        end
    end

    for _, name in ipairs(FILES) do
        local source = fs.combine(fullPath(STAGE_DIR), name)
        local destination = fullPath(name)

        if fs.exists(destination) then
            fs.delete(destination)
        end

        fs.move(source, destination)
    end

    clearStage()

    if not writeText(fullPath(VERSION_FILE), tostring(RELEASE_VERSION)) then
        print("Installed files but could not save version record")
        return
    end

    print("CAIRN update complete")
    print("Installed release: v" .. RELEASE_VERSION)
end

if args[1] == "--apply" then
    apply()
else
    bootstrap()
end
