local args = {...}

local RELEASE_VERSION = 14
local BASE_URL = "https://raw.githubusercontent.com/salesmanhappymask/Cairn/main/"
local TEMP = ".cairn_update_new"
local STAGE = ".cairn_update_stage"
local VERSION_FILE = ".cairn_version"
local STATE_FILE = ".cairn_drive_state"
local FILES = {"startup", "cairn", "update"}

local function readAll(path)
    if not fs.exists(path) then
        return nil
    end

    local h = fs.open(path, "r")
    if not h then
        return nil
    end

    local data = h.readAll()
    h.close()
    return data
end

local function writeAll(path, data)
    local h = fs.open(path, "w")
    if not h then
        return false
    end

    h.write(data)
    h.close()
    return true
end

local function releaseOf(name, data)
    local pattern

    if name == "update" then
        pattern = "local%s+RELEASE_VERSION%s*=%s*(%d+)"
    else
        pattern = "local%s+CAIRN_RELEASE%s*=%s*(%d+)"
    end

    local value = string.match(data, pattern)

    if not value then
        return nil
    end

    return tonumber(value)
end

local function fetch(name)
    if not http or not http.get then
        return nil, "HTTP API unavailable"
    end

    local token = tostring(os.getComputerID()) .. "_" .. tostring(math.floor(os.clock() * 1000))
    local ok, handle, err = pcall(
        http.get,
        BASE_URL .. name .. "?cairn=" .. token
    )

    if not ok then
        return nil, tostring(handle)
    end

    if not handle then
        return nil, tostring(err or "HTTP request failed")
    end

    local data = handle.readAll()
    handle.close()

    if not data or data == "" then
        return nil, "Empty response"
    end

    return data
end

local function validate(path)
    local fn, err = loadfile(path)

    if not fn then
        return false, err
    end

    return true
end

local function installed()
    local data = readAll(VERSION_FILE)

    if not data then
        return "unknown"
    end

    data = string.gsub(data, "%s+", "")

    if data == "" then
        return "unknown"
    end

    return data
end

local function bootstrap()
    print("CAIRN updater")
    print("Installed release: v" .. installed())
    print("Checking GitHub...")

    local data, err = fetch("update")

    if not data then
        print("Updater download failed")
        print(err or "")
        return
    end

    local release = releaseOf("update", data)

    if not release then
        print("Downloaded updater has no release number")
        return
    end

    print("Downloaded updater release: v" .. release)

    if fs.exists(TEMP) then
        fs.delete(TEMP)
    end

    if not writeAll(TEMP, data) then
        print("Could not write temporary updater")
        return
    end

    local ok, syntaxErr = validate(TEMP)

    if not ok then
        fs.delete(TEMP)
        print("Downloaded updater failed validation")
        print(syntaxErr or "")
        return
    end

    print("Running downloaded updater...")
    shell.run(TEMP, "--apply")

    if fs.exists(TEMP) then
        fs.delete(TEMP)
    end
end

local function apply()
    print("Applying CAIRN release v" .. RELEASE_VERSION)

    if fs.exists(STAGE) then
        fs.delete(STAGE)
    end

    fs.makeDir(STAGE)

    for _, name in ipairs(FILES) do
        print("Downloading " .. name)

        local data, err = fetch(name)

        if not data then
            fs.delete(STAGE)
            print("Download failed: " .. name)
            print(err or "")
            return
        end

        local release = releaseOf(name, data)

        if release ~= RELEASE_VERSION then
            fs.delete(STAGE)
            print("Release mismatch")
            print(name .. " is v" .. tostring(release) .. ", expected v" .. RELEASE_VERSION)
            print("GitHub may still be updating")
            return
        end

        local path = fs.combine(STAGE, name)

        if not writeAll(path, data) then
            fs.delete(STAGE)
            print("Could not stage " .. name)
            return
        end

        local ok, syntaxErr = validate(path)

        if not ok then
            fs.delete(STAGE)
            print("Validation failed: " .. name)
            print(syntaxErr or "")
            return
        end
    end

    print("All files verified as v" .. RELEASE_VERSION)
    print("Clearing old installation...")

    local preserve = {
        [TEMP] = true,
        [STAGE] = true,
        [STATE_FILE] = true
    }

    for _, name in ipairs(fs.list("")) do
        if not preserve[name] and fs.getDrive(name) == "hdd" and not fs.isReadOnly(name) then
            fs.delete(name)
        end
    end

    for _, name in ipairs(FILES) do
        local source = fs.combine(STAGE, name)

        if fs.exists(name) then
            fs.delete(name)
        end

        fs.move(source, name)
    end

    fs.delete(STAGE)

    if not writeAll(VERSION_FILE, tostring(RELEASE_VERSION)) then
        print("Installed files but could not save version record")
        return
    end

    print("CAIRN update complete")
    print("Installed release: v" .. RELEASE_VERSION)
end

if args[1] == "--apply" then
    apply()
else
    bootstrap()
end
