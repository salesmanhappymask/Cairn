local args = {...}

local RELEASE_VERSION = 4
local BASE_URL = "https://raw.githubusercontent.com/salesmanhappymask/Cairn/main/"
local TEMP_UPDATER = ".cairn_update_new"
local STAGE_DIR = ".cairn_update_stage"
local VERSION_FILE = ".cairn_version"

local FILES = {
    "startup",
    "locomotion_test",
    "cairn_probe",
    "update"
}

local function runningDir()
    if shell.getRunningProgram then
        return fs.getDir(shell.getRunningProgram())
    end
    return shell.dir()
end

local ROOT = runningDir()

local function path(name)
    if ROOT == "" then
        return name
    end
    return fs.combine(ROOT, name)
end

local function readText(filePath)
    if not fs.exists(filePath) then
        return nil
    end

    local h = fs.open(filePath, "r")
    if not h then
        return nil
    end

    local data = h.readAll()
    h.close()
    return data
end

local function writeText(filePath, data)
    local h = fs.open(filePath, "w")
    if not h then
        return false
    end

    h.write(data)
    h.close()
    return true
end

local function cacheToken()
    local id = 0
    local day = 0
    local time = 0

    if os.getComputerID then
        id = os.getComputerID()
    end

    if os.day then
        day = os.day()
    end

    if os.time then
        time = os.time()
    end

    return tostring(id) .. "_" .. tostring(day) .. "_" .. tostring(time) .. "_" .. tostring(math.floor(os.clock() * 1000))
end

local function fetch(name)
    if not http or not http.get then
        return nil, "HTTP API unavailable"
    end

    local url = BASE_URL .. name .. "?cairn=" .. cacheToken()
    local ok, handle, err = pcall(http.get, url)

    if not ok then
        return nil, tostring(handle)
    end

    if not handle then
        return nil, tostring(err or "HTTP request failed")
    end

    local data = handle.readAll()
    handle.close()

    if not data or data == "" then
        return nil, "Empty response"
    end

    return data
end

local function validateLua(filePath)
    local fn, err = loadfile(filePath)

    if not fn then
        return false, err
    end

    return true
end

local function extractRelease(name, data)
    local value

    if name == "update" then
        value = string.match(
            data,
            "local%s+RELEASE_VERSION%s*=%s*(%d+)"
        )
    else
        value = string.match(
            data,
            "local%s+CAIRN_RELEASE%s*=%s*(%d+)"
        )
    end

    if not value then
        return nil
    end

    return tonumber(value)
end

local function installedVersion()
    local value = readText(path(VERSION_FILE))

    if not value then
        return "unknown"
    end

    value = string.gsub(value, "%s+", "")

    if value == "" then
        return "unknown"
    end

    return value
end

local function cleanStage()
    if fs.exists(path(STAGE_DIR)) then
        fs.delete(path(STAGE_DIR))
    end
end

local function bootstrap()
    print("CAIRN updater")
    print("Installed release: v" .. installedVersion())
    print("Checking GitHub for latest updater...")

    local data, err = fetch("update")

    if not data then
        print("Updater download failed")
        print(err or "")
        return
    end

    local remoteVersion = extractRelease("update", data)

    if not remoteVersion then
        print("Downloaded updater has no readable release number")
        return
    end

    print("Downloaded updater release: v" .. remoteVersion)

    local tempPath = path(TEMP_UPDATER)

    if fs.exists(tempPath) then
        fs.delete(tempPath)
    end

    if not writeText(tempPath, data) then
        print("Could not write temporary updater")
        return
    end

    local valid, syntaxErr = validateLua(tempPath)

    if not valid then
        fs.delete(tempPath)
        print("Downloaded updater failed validation")
        print(syntaxErr or "")
        return
    end

    print("Running downloaded updater...")
    local ran = shell.run(tempPath, "--apply")

    if fs.exists(tempPath) then
        fs.delete(tempPath)
    end

    if ran == false then
        print("Update did not complete")
    end
end

local function apply()
    print("Applying CAIRN release v" .. RELEASE_VERSION)

    cleanStage()
    fs.makeDir(path(STAGE_DIR))

    print("Downloading files...")

    for _, name in ipairs(FILES) do
        print("  " .. name)

        local data, err = fetch(name)

        if not data then
            cleanStage()
            print("Download failed: " .. name)
            print(err or "")
            return
        end

        local fileRelease = extractRelease(name, data)

        if fileRelease ~= RELEASE_VERSION then
            cleanStage()
            print("Release consistency check failed")
            print(
                name ..
                " is v" ..
                tostring(fileRelease) ..
                ", expected v" ..
                RELEASE_VERSION
            )
            print("GitHub may still be propagating the new release.")
            print("Wait briefly and run update again.")
            return
        end

        local staged = fs.combine(path(STAGE_DIR), name)

        if not writeText(staged, data) then
            cleanStage()
            print("Could not stage: " .. name)
            return
        end

        local valid, syntaxErr = validateLua(staged)

        if not valid then
            cleanStage()
            print("Validation failed: " .. name)
            print(syntaxErr or "")
            return
        end
    end

    print("All release files verified as v" .. RELEASE_VERSION)
    print("Clearing old installation...")

    local preserve = {
        [TEMP_UPDATER] = true,
        [STAGE_DIR] = true
    }

    for _, name in ipairs(fs.list(ROOT)) do
        local full = path(name)
        local drive = fs.getDrive(full)

        if not preserve[name] and drive == "hdd" and not fs.isReadOnly(full) then
            fs.delete(full)
        end
    end

    print("Installing release v" .. RELEASE_VERSION .. "...")

    for _, name in ipairs(FILES) do
        local staged = fs.combine(path(STAGE_DIR), name)
        local destination = path(name)

        if fs.exists(destination) then
            fs.delete(destination)
        end

        fs.move(staged, destination)
    end

    cleanStage()

    if not writeText(path(VERSION_FILE), tostring(RELEASE_VERSION)) then
        print("Files installed, but version record could not be written")
        return
    end

    print("CAIRN update complete")
    print("Installed release: v" .. RELEASE_VERSION)
end

if args[1] == "--apply" then
    apply()
else
    bootstrap()
end
